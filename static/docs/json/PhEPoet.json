        },
        "manuscripts": {
          "ms": {
            "@abbrev": "Mras",
            "@language": "Greek",
            "@show": "yes",
            "name": "Mras",
            "bibliography": "Carl R. Mras, Poets: The Epic Poets Theodotus and Philo and Ezekiel the Tragedian (vol 2 of Fragments from Hellenistic Jewish Authors; TT 30; PS 12; Atlanta: Scholars Press, 1989), 234-245. Fragments 1–2: Eusebius, Praeparatio Evangelica 9.20.1-2; Fragment 3: Eusebius, Praeparatio Evangelica 9.24.1; Fragments 4–6: Eusebius, Praeparatio Evangelica 9.37.1-3."
          }
        },
        "text": {
          "div": {
            "@number": "9",
            "div": {
              "@number": "24",
              "div": [
                {
                  "@number": "Heading",
                  "unit": {
                    "@id": "9",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "ΦΙΛΩΝΟΣ ΠΕΡΙ ΤΟΥ ΙΩΣΗΦ· ΑΠΟ ΤΗΣ ΑΥΤΗΣ ΓΡΑΦΗΣ"
                    }
                  }
                },
                {
                  "@number": "1",
                  "unit": [
                    {
                      "@id": "10",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "\"Μαρτυρεῖ δὲ ταῖς ἱεραῖς βίβλοις καὶ Φίλων ἐν τῇ ιδ᾽ τῶν Περὶ Ἱεροσόλυμα, \nλέγων οὕτως·"
                      }
                    },
                    {
                      "@id": "11",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "'Τοῖσιν ἕδος μακαριστὸν ὅλης μέγας ἔκτισεν \n\tἄκτωρ \n      ὕψιστος καὶ πρόσθεν ἀφ᾽ Ἁβραάμοιο καὶ Ἰσὰκ \n      Ἰακὼβ εὐτέκνοιό θ᾽ ὅθεν Ἰωσήφ, ὃς ὀνείρων\n      θεσπιστὴς σκηπτοῦχος ἐν Αἰγύπτοιο θρόνοισι, \n      δινεύσας λαθραῖα χρόνου πλημμυρίδι μοίρης',"
                      }
                    },
                    {
                      "@id": "12",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "καὶ τὰ ἑξῆς.  ταῦτα καὶ περὶ τοῦ Ἰωσήφ.\""
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "@title": "Praep. Evang. (Frag. 4)",
        "@author": "Eusebius",
        "@fragment": "4",
        "@language": "Greek",
        "divisions": {
