            "@show": "yes",
            "name": "Mras",
            "bibliography": "Carl R. Mras, Poets: The Epic Poets Theodotus and Philo and Ezekiel the Tragedian (vol 2 of Fragments from Hellenistic Jewish Authors; TT 30; PS 12; Atlanta: Scholars Press, 1989), 234-245. Fragments 1–2: Eusebius, Praeparatio Evangelica 9.20.1-2; Fragment 3: Eusebius, Praeparatio Evangelica 9.24.1; Fragments 4–6: Eusebius, Praeparatio Evangelica 9.37.1-3."
          }
        },
        "text": {
          "div": {
            "@number": "9",
            "div": {
              "@number": "20",
              "div": [
                {
                  "@number": "1",
                  "unit": [
                    {
                      "@id": "5",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "\"οἷς μετ᾽ ὀλίγα ἐπιφέρει·"
                      }
                    },
                    {
                      "@id": "6",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "'Ἀρτίχερος θηκτοῖο ξιφηφόρον ἐντύνοντος \n      λήματι καὶ σφαράγοιο παρακλιδὸν ἀθροισθέντος· \n      | ἀλλ᾽ ὁ μὲν ἐν χείρεσσι κερασφόρον ὤπασε κριόν,'"
                      }
                    },
                    {
                      "@id": "7",
                      "@group": "0",
                      "@parallel": "",
                      "reading": {
                        "@option": "0",
                        "@mss": "Mras ",
                        "@linebreak": "doubleFollowing",
                        "#text": "καὶ τὰ τούτοις ἑπόμενα.\""
                      }
                    }
                  ]
                },
                {
                  "@number": "2",
                  "unit": {
                    "@id": "8",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "Ταῦτα μὲν δὴ ἀπὸ τῆς προειρημένης τοῦ Πολυΐστορος γραφῆς."
                    }
                  }
                }
              ]
            }
          }
        }
      },
      {
        "@title": "Praep. Evang. (Frag. 3)",
        "@author": "Eusebius",
        "@fragment": "3",
        "@language": "Greek",
        "divisions": {
