            }
          ]
        },
        "manuscripts": {
          "ms": {
            "@abbrev": "Mras",
            "@language": "Greek",
            "@show": "yes",
            "name": "Mras",
            "bibliography": "Carl R. Mras, Poets: The Epic Poets Theodotus and Philo and Ezekiel the Tragedian (vol 2 of Fragments from Hellenistic Jewish Authors; TT 30; PS 12; Atlanta: Scholars Press, 1989), 234-245. Fragments 1–2: Eusebius, Praeparatio Evangelica 9.20.1-2; Fragment 3: Eusebius, Praeparatio Evangelica 9.24.1; Fragments 4–6: Eusebius, Praeparatio Evangelica 9.37.1-3."
          }
        },
        "text": {
          "div": {
            "@number": "9",
            "div": {
              "@number": "37",
              "div": {
                "@number": "2",
                "unit": [
                  {
                    "@id": "17",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "\"οἷς πάλιν ὑποβὰς περὶ τῆς πληρώσεως ἐπιλέγει·"
                    }
                  },
                  {
                    "@id": "18",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "'Ῥεῦμα γὰρ ὑψιφάεννον, ἐν ὑετίοις νιφετοῖσιν \n      ἱέμενον, πολυγηθές, ὑπαὶ πύργοις συνόροισιν \n      στρωφᾶται, καὶ ξηρὰ πέδῳ κεκονιμένα κρήνης \n      τηλεφαῆ δείκνυσιν ὑπέρτατα θάμβεα λαῶν,'"
                    }
                  },
                  {
                    "@id": "19",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "καὶ τὰ τούτοις ἀκόλουθα.\""
                    }
                  }
                ]
              }
            }
          }
        }
      },
      {
        "@title": "Praep. Evang. (Frag. 6)",
        "@author": "Eusebius",
        "@fragment": "6",
        "@language": "Greek",
        "divisions": {
          "division": [
            {
