        "manuscripts": {
          "ms": {
            "@abbrev": "Mras",
            "@language": "Greek",
            "@show": "yes",
            "name": "Mras",
            "bibliography": "Carl R. Mras, Poets: The Epic Poets Theodotus and Philo and Ezekiel the Tragedian (vol 2 of Fragments from Hellenistic Jewish Authors; TT 30; PS 12; Atlanta: Scholars Press, 1989), 234-245. Fragments 1–2: Eusebius, Praeparatio Evangelica 9.20.1-2; Fragment 3: Eusebius, Praeparatio Evangelica 9.24.1; Fragments 4–6: Eusebius, Praeparatio Evangelica 9.37.1-3."
          }
        },
        "text": {
          "div": {
            "@number": "9",
            "div": {
              "@number": "37",
              "div": {
                "@number": "3",
                "unit": [
                  {
                    "@id": "20",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "\"εἶτα πάλιν περὶ τῆς τοῦ ἀρχιερέως κρήνης καὶ τῆς ἀποχετεύσεως διέξεισιν οὕτως·"
                    }
                  },
                  {
                    "@id": "21",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "'Αἰπὺ δ᾽ ἄρ᾽ ἐκπτύουσι διὰ χθονὸς ὑδροχόοισι σωλῆνες,'"
                    }
                  },
                  {
                    "@id": "22",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "καὶ ὅσα ἄλλα τούτοις ἕπεται.\""
                    }
                  },
                  {
                    "@id": "23",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "#text": "Τοσαῦτα μὲν δὴ τὰ ἀπὸ τῶν Ἀλεξάνδρου τοῦ Πολυΐστοπος."
                    }
                  }
                ]
              }
            }
          }
        }
      }
    ]
