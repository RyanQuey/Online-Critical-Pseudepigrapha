            "name": "Mras",
            "bibliography": "Carl R. Mras, Poets: The Epic Poets Theodotus and Philo and Ezekiel the Tragedian (vol 2 of Fragments from Hellenistic Jewish Authors; TT 30; PS 12; Atlanta: Scholars Press, 1989), 234-245. Fragments 1–2: Eusebius, Praeparatio Evangelica 9.20.1-2; Fragment 3: Eusebius, Praeparatio Evangelica 9.24.1; Fragments 4–6: Eusebius, Praeparatio Evangelica 9.37.1-3."
          }
        },
        "text": {
          "div": {
            "@number": "9",
            "div": {
              "@number": "20",
              "div": {
                "@number": "1",
                "unit": [
                  {
                    "@id": "1",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "\"Φησὶ δὲ περὶ τούτου καὶ Φίλων ἐν τῷ πρώτῳ τῶν Περὶ Ἱεροσόλυμα·"
                    }
                  },
                  {
                    "@id": "2",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "ΦΙΛΩΝΟΣ ΠΕΡΙ ΤΟΥ ΑΥΤΟΥ"
                    }
                  },
                  {
                    "@id": "3",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "'Ἔκλυον ἀρχεγόνοισι τὸ μηρίον ὥς ποτε θεσμοῖς, \n      Ἁβραὰμ κλυτοηχὲς ὑπερτέρῳ ἅμματι δεσμῶν, \n      παμφαές, πλήμμυρε μεγαυχήτοισι λογισμοῖς, \n      θειοφιλῆ θέλγητρα. λιπόντι γὰρ ἀγλαὸν ἕρκος \n      αἰνοφύτων ἔκκαυμα βριήπυος αἰνετὸς ἴσχων \n      ἀθάνατον ποίησεν ἑὴν φάτιν, ἐξότε κείνου \n      ἔκγονος αἰνογόνοιο πολύμνιον ἔλλαχε κῦδος,'"
                    }
                  },
                  {
                    "@id": "4",
                    "@group": "0",
                    "@parallel": "",
                    "reading": {
                      "@option": "0",
                      "@mss": "Mras ",
                      "@linebreak": "doubleFollowing",
                      "#text": "καὶ τὰ ἑξῆς·\""
                    }
                  }
                ]
              }
            }
          }
        }
      },
      {
        "@title": "Praep. Evang. (Frag. 2)",
        "@author": "Eusebius",
        "@fragment": "2",
        "@language": "Greek",
        "divisions": {
          "division": [
            {
              "@label": "Book",
