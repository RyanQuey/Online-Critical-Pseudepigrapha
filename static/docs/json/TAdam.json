el": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܥܡ ܩܘܖ̈ܒܢܐ ܕܐܦܩ̣"}}, {"@id": "199", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܐܕܡ ܡܢ ܦܪܕܝܣܐ ܕܗܒܐ"}}, {"@id": "200", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܘܡܘܪܐ ܘܠܒܘܢܬܐ ܀"}}, {"@id": "201", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܘܐ̈ܬܝܢ ܒ̈ܢܝ ܡ̈ܠܟܐ"}}, {"@id": "202", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "doubleFollowing", "#text": "ܡ̈ܓܘܫܐ ܘܫ̇ܩܠܝܢ ܠܗܘܢ̇"}}, {"@id": "203", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܘܡ̈ܝܬܝܢ ܠܗܘܢ ܠܒܪ ܐܠܗܐ"}}, {"@id": "204", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܠܒܝܬ ܠܚܡ ܕܝܗܘܕܐ"}}, {"@id": "205", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܠܡܥܪܬܐ:  ܫܠܡ‍[ܬ] ܕܝܬܝܩܐ"}}, {"@id": "206", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "A ", "@linebreak": "following", "#text": "ܕܐܒܘܢ ܐܕܡ܀"}}]}]}]}}, {"@title": "Greek", "@author": "Anonymous", "@language": "Greek", "divisions": {"division": [{"@label": "Chapter", "@delimiter": ":"}, {"@label": "Verse"}]}, "manuscripts": {"ms": [{"@abbrev": "PCod.Gr.2419", "@language": "Greek", "@show": "yes", "name": "Paris Codex Gr. 2419, folio 247b", "bibliography": "M. R. James, “A Fragment of the Apocalypse of Adam in Greek,” in Apocrypha Anecdota II (Texts and Studies 2.3; Cambridge: Cambridge University Press, 1893), 138-145."}, {"@abbrev": "Cedrenus", "@language": "Greek", "@show": "yes", "name": "Cedrenus", "bibliography": ["M. R. James, “A Fragment of the Apocalypse of Adam in Greek,” in Apocrypha Anecdota II (Texts and Studies 2.3; Cambridge: Cambridge University Press, 1893), 138-145.", "G. J. Reinink, “Das Problem des Ursprung des Testamentes Adams,” Orientalia Christiana Analecta 197 (1972) 387-99"]}]}, "text": {"div": [{"@number": "1", "div": [{"@number": "1", "unit": {"@id": "1", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα α´ καλεῖται איאהכ ἐν ᾗ ἀγαθόν ἐστιν προσεύχεσθαι."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ὥρᾳ πρώτῃ ἡμερινῇ πρώτη εὐχὴ ἐπιτελεῖται ἐν τῷ οὐρανῷ."}]}}, {"@number": "2", "unit": {"@id": "2", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα β´ καλεῖται נַכוּת ἐν ᾗ εὐχαὶ τῶν ἀγγέλων καὶ ὕμνοι."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "δευτέρᾳ εὐχὴ ἀγγέλων."}]}}, {"@number": "3", "unit": {"@id": "3", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα γ´ καλεῖται ףַרַש ἐν ᾗ εὐχαριστοῦσι τὰ πετεινὰ τῷ θεῷ· ἐν αὐτῇ τῇ ὥρᾳ ἀποτελεῖται πᾶν στοιχεῖον."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "τρίτῃ εὐχὴ πτηνῶν."}]}}, {"@number": "4", "unit": {"@id": "4", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα δ´ καλεῖται . . . ἐν ᾗ εὐχαριστοῦσιν πάντα τὰ ποιήματα τοῦ θεοῦ, ἐν ᾗ στοιχειοῦνται . . . καὶ πάντα τὰ ἰοβόλα."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "τετάρτῃ εὐχὴ κτηνῶν."}]}}, {"@number": "5", "unit": {"@id": "5", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ε´ καλεῖται . . . ἐν ᾗ αἰνεῖ πᾶν ζῶον τὸν θεόν· ἐν ᾗ ἀποτελεῖται πᾶν . . . ."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "πεμπτῇ εὐχὴ θηρίων."}]}}, {"@number": "6", "unit": {"@id": "6", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ϛ´ καλεῖται . . . {ἐν}ᾗ δυσωποῦσιν τὰ χερουβὶμ τὸν θεόν ὑπὲρ ἀνθρώπων."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ἕκτῃ ἀγγέλων παράστασις καὶ διάκρισις πάσης κτίσεως."}]}}, {"@number": "7", "unit": {"@id": "7", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ζ´ καλεῖται . . . ἐν ᾗ αἰνοῦσιν ἀγγέλων τάγματα καὶ παριστάμενα τῷ θεῷ."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ἑβδόμῃ ἀγγέλων εἴσοδος πρὸς θεὸν καὶ ἔξοδος ἀγγέλων."}]}}, {"@number": "8", "unit": {"@id": "8", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα η´ καλεῖται ן׳כַנ."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ὀγδόῃ αἴνεσις καὶ θυσίαι ἀγγέλων."}]}}, {"@number": "9", "unit": {"@id": "9", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα θ´ καλεῖται . . . {ἐν} ᾗ εὐχὴ ἀνθρώπων· ἤ χα παυρουν ἐν ᾗ οὐδὲν τελεῖται."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ἐννάτῃ δέησις καῖ λατρεία ἀνθρώπου."}]}}, {"@number": "10", "unit": {"@id": "10", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ι´ . . . ἐν ᾗ αἰνοῦσιν τὰ ὕδατα, καὶ πνεῦμα θεοῦ καταβαῖνον ἐπιπολάζει αὐτοῖς καὶ ἁγιάζει αὐτά· εἰ γὰρ μὴ οὕτως ἦν, ἔβλαπτον ἂν οἱ πονηροὶ δαίμονες ἀνθρώπους· ἐν ᾗ ἐ{ὰν} ἄνθρωπος ἄρῃ נֵרונ ( νέρον ) καὶ μίξῃ μετὰ ἁγίου ἐλαίου, πᾶν נושׂמַ ( νόσημα ) ἰᾶται· καὶ δαιμονῶντας καθαίρει καὶ δαίμονας ἀπελαύνει."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "δεκάτῃ ἐπισκοπαὶ ὑδάτων καὶ δεήσεις οὐρανίων καὶ ἐπιγείων."}]}}, {"@number": "11", "unit": {"@id": "11", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ια´ . . . ἐν ᾗ εὐφραίνονται οἱ ἐκλεκτοὶ τοῦ θεοῦ."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "ἑνδεκάτῃ ἀνθομολόγησις καὶ ἀγαλλίασις πάντων."}]}}, {"@number": "12", "unit": {"@id": "12", "@group": "0", "@parallel": "", "reading": [{"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ιβ´ . . . ἐν ᾗ εὐπρόσδεκτοι αἱ τῶν ἀνθρώπων εὐχαί."}, {"@option": "1", "@mss": "Cedrenus ", "#text": "δωδεκάτῃ ἔντευξις ἀνθρώπων εἰς εὐδοκίας."}]}}]}, {"@number": "2", "div": [{"@number": "1", "unit": {"@id": "13", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα α´ . . . ἐν ᾗ οἱ δαίμονες αἰνοῦντες τὸν θεὸν οὔτε ἀδικοῦσιν οὔτε κολάζουσιν."}}}, {"@number": "2", "unit": {"@id": "14", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα β´ . . . ἐν ᾗ ὑμνοῦσιν οἱ ἰχθύες τὸν θεόν, καὶ τὸ τοῦ πυρὸς βάθος· ἐν ᾗ ὀφείλει στοιχειοῦσθαι ἀποτελέσματα εἰς δράκοντας καὶ . . . καὶ πῦρ."}}}, {"@number": "3", "unit": {"@id": "15", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα γ´ . . . ἐν ᾗ αἰνοῦσιν ὄφεις καὶ κύνεις καὶ πῦρ."}}}, {"@number": "4", "unit": {"@id": "16", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα δ´ . . . ἐν ᾗ διέρχονται δαίμονες ἐν τοῖς μνήμασιν, καὶ ἐρχόμενος ἐκεῖσε βλαβήσεται καὶ φόβον καὶ φρίκην ἐκ τῆς τῶν δαιμόνων λήψεται φαντασίας· ἐν ᾗ ὀφείλει στοιχειοῦσθαι ἀποτελέσματα . . . καὶ παντὸς γοητικοῦ πράγματος."}}}, {"@number": "5", "unit": {"@id": "17", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ε´ . . . ἐν ᾗ αἰνοῦσιν τὰ ὕδατα τὸν θεὸν τοῦ οὐρανοῦ."}}}, {"@number": "6", "unit": {"@id": "18", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα  ϛ´ . . . ὅτε δέον ἡσυχάζειν καὶ ἀναπαῦσαι, διότι ἔχει φόβον."}}}, {"@number": "7", "unit": {"@id": "19", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ζ´ . . . ἐν ᾗ ἀναπαύει πάντα {τὰ} ζῶα ταῦτα. ἐάν τις ἄνθρωπος καθαρὸς ἁρπάσῃ נַרונ ( νέρον ) καὶ βάλλει αὐτὸ ὁ ἱερεὺς καὶ μίξῃ μετ᾽ ἐλαίου καὶ ἁγιάσῃ αὐτὸ καὶ ἀλείψῃ ἀπ᾽ αὐτὸ ἀσθενῆ ἀγρυπνοῦντα παρευθὺ τῆς νόσου ἀπαλλαγήσεται."}}}, {"@number": "8", "unit": {"@id": "20", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα η´ . . . ἐν ᾗ δὲ ἀποτελοῦμεν στοιχεῖον περὶ . . . καὶ παντοίων φυτῶν."}}}, {"@number": "9", "unit": {"@id": "21", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα θ´ . . . ἐν ᾗ τελεῖται οὐδέν."}}}, {"@number": "10", "unit": {"@id": "22", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "----"}}}, {"@number": "11", "unit": {"@id": "23", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ια´ . . . ἐν ᾗ ἀνοίγονται αἱ πύλαι τοῦ οὐρανοῦ καὶ ἄνθρωπος ἐν κατανύξει γενόμενος εὐήκοος γενήσεται· ἐν ταύτῃ πέτονται ταῖς πτέρυξιν σὺν ἤχῳ οἱ ἄγγελοι καὶ χερουμβὶμ καὶ σεραφίμ· καί ἐστιν χαρὰ ἐν οὐρανῷ καὶ γῇ· ἀνατέλλει δὲ καὶ ὁ ἥλιος ἐξ Ἐδέμ."}}}, {"@number": "12", "unit": {"@id": "24", "@group": "0", "@parallel": "", "reading": {"@option": "0", "@mss": "PCod.Gr.2419 ", "#text": "ὥρα ιβ´ . . . ἐν ᾗ ἀναπαύονται τὰ πύρινα τάγματα. αὗταί εἰσιν αἱ ὀνομασίαι τῶν ὡρῶν· τῷ οὖν καλῶς ταῦτα νοήσαντι οὐδὲν . . . τοιούτων ἀποκρυβήσεται ἀλλὰ πάντα ὑποταγήσονται."}}}]}]}}]}}