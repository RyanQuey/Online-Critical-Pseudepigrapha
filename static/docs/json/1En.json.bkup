											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "τῆς ἀκατασκευάστου."
											},
											"_id": "2011",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
