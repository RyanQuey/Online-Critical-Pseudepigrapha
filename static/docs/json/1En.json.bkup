				},
				"text": {
					"div": [
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Λόγος εὐλογίας Ἑνώχ, καθὼς εὐλόγησεν ἐκλεκτοὺς δικαίους οἵτινες ἔσονται εἰς ἡμέραν ἀνάγκης ἐξᾶραι πάντας τοὺς ἐχθρούς, καὶ σωθήσονται δίκαιοι."
										},
										"_id": "1739",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "Καὶ ἀναλαβὼν"
											},
											"_id": "1740",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τὴν παραβολὴν αὐτοῦ εἶπεν"
											},
											"_id": "1741",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "Ἑνώχ· Ἄνθρωπος δίκαιός ἐστιν,"
											},
											"_id": "1742",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "[ᾧ]"
												}
											],
											"_id": "1743",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ὅρασις ἐκ τοῦ θεοῦ αὐτῷ ἀνεῳγμένη ἦν· ἔχων τὴν ὅρασιν τοῦ ἁγίου καὶ τοῦ οὐρανοῦ. ἔδειξέν μοι,"
											},
											"_id": "1744",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ ἁγιολόγων ἁγίων ἤκουσα ἐγώ, καὶ ὡς ἤκουσα παρ᾽ αὐτῶν πάντα"
											},
											"_id": "1745",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ ἔγνων ἐγὼ θεωρῶν· καὶ οὐκ"
											},
											"_id": "1746",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "εἰς τὴν νῦν γενεὰν διενοούμην, ἀλλὰ ἐπὶ πόρρω οὖσαν ἐγὼ λαλῶ."
											},
											"_id": "1747",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "Καὶ περὶ τῶν ἐκλεκτῶν νῦν λέγω καὶ περὶ αὐτῶν ἀνέλαβον τὴν παραβολήν μου."
											},
											"_id": "1748",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ ἐξελεύσεται ὁ ἅγιός μου ὁ μέγας ἐκ τῆς κατοικήσεως αὐτοῦ,"
											},
											"_id": "1749",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ ὁ θεὸς τοῦ αἰῶνος ἐπὶ γῆν πατῆσει ἐπὶ τὸ Σεινὰ ὄρος καὶ φανήσεται ἐκ"
											},
											"_id": "1750",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τῆς παρεμβολῆς αὐτοῦ, καὶ φανήσεται ἐν τῇ δυνάμει τῆς ἰσχύος αὐτοῦ"
											},
											"_id": "1751",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἀπὸ τοῦ οὐρανοῦ τῶν οὐρανῶν."
											},
											"_id": "1752",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ φοβηθήσονται πάντες καὶ πιστεύσουσιν οἱ ἐγρήγοροι, καὶ ᾄσουσιν ἀπόκρυφα ἐν πᾶσιν τοῖς ἄκροις τῆς"
											},
											"_id": "1753",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "[γῆς]"
												}
											],
											"_id": "1754",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "· καὶ σεισθήσονται πάντα τὰ ἄκρα τῆς γῆς, καὶ λήμψεται αὐτοὺς τρόμος καὶ φόβος μέγας μέχρι τῶν περάτων τῆς γῆς."
											},
											"_id": "1755",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ σεισθήσονται καὶ πεσοῦνται καὶ διαλυθήσονται ὄρη ὑψηλά, καὶ"
											},
											"_id": "1756",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ταπεινωθήσονται"
												},
												{
													"_option": "1",
													"_mss": "Gizeh* ",
													"__text": "πεινωθησονται"
												}
											],
											"_id": "1757",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "βουνοὶ ὑψηλοὶ τοῦ διαρυῆναι ὄρη, καὶ τακήσονται ὡς κηρὸς ἀπὸ προσώπου πυρὸς ἐν φλογί."
											},
											"_id": "1758",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ διασχισθήσεται ἡ γῆ σχίσμα ῥαγάδι, καὶ πάντα ὅσα ἐστὶν ἐπὶ τῆς γῆς ἀπολεῖται, καὶ κρίσις ἔσται κατὰ πάντων."
										},
										"_id": "1759",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ μετὰ τῶν δικαίων τὴν εἰρήνην ποιήσει, καὶ ἐπὶ τοὺς ἐκλεκτοὺς ἔσται συντήρησις καὶ εἰρήνη, καὶ ἐπ᾽ αὐτοὺς"
											},
											"_id": "1760",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Swete Charles Black Dindorf ",
													"__text": "γενήσεται"
												},
												{
													"_option": "1",
													"_mss": "Gizeh ",
													"__text": "γενηται"
												}
											],
											"_id": "1761",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἔλεος, καὶ ἔσονται πάντες τοῦ θεοῦ, καὶ τὴν εὐδοκίαν δώσει αὐτοῖς καὶ πάντας εὐλογήσει καὶ πάντων ἀντιλήμψεται καὶ βοηθήσει ἡμῖν, καὶ φανήσεται αὐτοῖς φῶς καὶ ποιήσει ἐπ᾽ αὐτοὺς εἰρήνην."
											},
											"_id": "1762",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "8"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὅτι ἔρχεται"
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "ἰδοὺ ἦλθεν κύριος"
												}
											],
											"_id": "1763",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "σὺν ταῖς μυριάσιν αὐτοῦ καὶ τοῖς ἁγίοις αὐτοῦ,"
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "ἐν ἁγίαις μυριάσιν αὐτοῦ,"
												}
											],
											"_id": "1764",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Jude ",
												"__text": "ποιῆσαι κρίσιν κατὰ πάντων, καὶ"
											},
											"_id": "1765",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἀπολέσει"
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "ἐλέγξαι"
												}
											],
											"_id": "1766",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Jude ",
												"__text": "πάντας τοὺς ἀσεβεῖς,"
											},
											"_id": "1767",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἐλέγξει πᾶσαν σάρκα περὶ πάντων"
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "περὶ πάντων τῶν"
												}
											],
											"_id": "1768",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Jude ",
												"__text": "ἔργων"
											},
											"_id": "1769",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "τῆς"
												},
												{
													"_option": "1",
													"_mss": "Jude "
												}
											],
											"_id": "1770",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Jude ",
												"__text": "ἀσεβείας αὐτῶν ὧν ἠσέβησαν καὶ"
											},
											"_id": "1771",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "περὶ πάντων τῶν"
												}
											],
											"_id": "1772",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "σκληρῶν ὧν ἐλάλησαν λόγων, καὶ περὶ πάντων ὧν κατελάλησαν"
												},
												{
													"_option": "1",
													"_mss": "Jude ",
													"__text": "σκληρῶν ὧν ἐλάλησαν"
												}
											],
											"_id": "1773",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Jude ",
												"__text": "κατ᾽ αὐτοῦ ἁμαρτωλοὶ ἀσεβεῖς."
											},
											"_id": "1774",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "9"
								}
							],
							"_number": "1"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "Κατανοήσατε πάντα τὰ ἔργα ἐν τῷ οὐρανῷ, πῶς οὐκ ἠλλοίωσαν τὰς ὁδοὺς αὐτῶν, καὶ τοὺς φωστῆρας τοὺς ἐν τῷ οὐρανῷ ὡς τὰ πάντα ἀνατέλλει καὶ δύνει, τεταγμένος ἕκαστος ἐν τῷ τεταγμένῳ καιρῷ, καὶ ταῖς ἑορταῖς αὐτῶν φαίνονται,"
											},
											"_id": "1775",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "καὶ οὐ παραβαίνουσιν τὴν ἰδίαν τάξιν."
											},
											"_id": "1776",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἴδετε τὴν γῆν καὶ διανοήθητε περὶ τῶν ἔργων τῶν ἐν αὐτῇ"
											},
											"_id": "1777",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "γεινομενων"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "γενομένων"
												},
												{
													"_option": "2",
													"_mss": "Swete Charles Dindorf ",
													"__text": "γινομένων"
												}
											],
											"_id": "1778",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἀπ᾽ ἀρχῆς μέχρι τελειώσεως ὥς εἰσιν φθαρτά, ὡς οὐκ ἀλλοιοῦνται, οὐδὲν τῶν ἐπὶ γῆς, ἀλλὰ πάντα ἔργα θεοῦ ὑμῖν φαίνεται."
											},
											"_id": "1779",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδετε τὴν θερείαν καὶ τὸν χειμῶνα ..."
										},
										"_id": "1780",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								}
							],
							"_number": "2"
						},
						{
							"div": {
								"unit": {
									"reading": {
										"_option": "0",
										"_mss": "Gizeh ",
										"__text": ". . . καταμάθετε καὶ ἴδετε πάντα τὰ δένδρα . . ."
									},
									"_id": "1781",
									"_group": "0",
									"_parallel": ""
								},
								"_number": "1"
							},
							"_number": "3"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πῶς τὰ φύλλα χλωρὰ ἐν αὐτοῖς σκέποντα τὰ δένδρα, καὶ πᾶς ὁ καρπὸς αὐτῶν εἰς τιμὴν καὶ δόξαν. διανοήθητε καὶ γνῶτε περὶ πάντων τῶν ἔργων αὐτοῦ, καὶ νοήσατε ὅτι θεὸς ζῶν ἐποίησεν αὐτὰ οὕτως, καὶ ζῇ εἰς πάντας τοὺς αἰῶνας·"
										},
										"_id": "1782",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὰ ἔργα αὐτοῦ πάντα ὅσα ἐποίησεν εἰς τοὺς αἰῶνας ἀπὸ ἐνιαυτοῦ εἰς ἐνιαυτὸν γινόμενα πάντα οὕτως, καὶ πάντα ὅσα ἀποτελοῦσιν αὐτῷ τὰ ἔργα, καὶ οὐκ ἀλλοιοῦνται αὐτῶν τὰ ἔργα, ἀλλ᾽ ὡσπερεὶ κατὰ ἐπιταγὴν τὰ πάντα γίνεται."
										},
										"_id": "1783",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδετε πῶς ἡ θάλασσα καὶ οἱ ποταμοὶ ὡς ὁμοίως ἀποτελοῦσιν καὶ οὐκ ἀλλοιοῦσιν αὐτῶν τὰ ἔργα ἀπὸ τῶν λόγων αὐτοῦ."
										},
										"_id": "1784",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὑμεῖς δὲ οὐκ ἐνεμείνατε οὐδὲ ἐποιήσατε κατὰ τὰς ἐντολὰς αὐτοῦ, ἀλλὰ ἀπέστητε καὶ κατελαλήσατε μεγάλους καὶ σκληροὺς λόγους ἐν στόματι ἀκαθαρσίας ὑμῶν κατὰ τῆς μεγαλωσύνης αὐτοῦ. ὅτι κατελαλήσατε ἐν τοῖς ψεύμασιν ὑμῶν, σκληροκάρδιοι, οὐκ ἔστιν εἰρήνη ὑμῖν."
										},
										"_id": "1785",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τοιγὰρ τὰς ἡμέρας ὑμῶν ὑμεῖς"
											},
											"_id": "1786",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "κατηρασασθαι"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "καταράσεσθε"
												}
											],
											"_id": "1787",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "κατα"
												},
												{
													"_option": "1",
													"_mss": "Dillman Lods Charles Black ",
													"__text": "καὶ τὰ ἔτη"
												}
											],
											"_id": "1788",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τῆς ζωῆς ὑμῶν ἀπολεῖται, καὶ τὰ ἔτη τῆς ἀπωλείας ὑμῶν πληθυνθήσεται ἐν κατάρᾳ αἰώνων, καὶ οὐκ ἔσται ὑμῖν ἔλεος καὶ εἰρήνη."
											},
											"_id": "1789",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τότε ἔσται τὰ ὀνόματα ὑμῶν εἰς κατάραν αἰώνιον πᾶσιν τοῖς δικαίοις, καὶ ἐν ὑμῖν καταράσονται πάντες οἱ καταρώμενοι, καὶ πάντες οἱ ἁμαρτωλοὶ καὶ ἀσεβεῖς ἐν ὑμῖν ὀμοῦνται, καὶ πάντες οἱ"
											},
											"_id": "1790",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "αμαρτοι"
												},
												{
													"_option": "1",
													"_mss": "Swete Charles Black ",
													"__text": "ἀναμάρτητοι"
												},
												{
													"_option": "2",
													"_mss": "F-R ",
													"__text": "ἀμίαντοι"
												}
											],
											"_id": "1791",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "χαρήσονται, καὶ ἔσται αὐτοῖς λύσις ἁμαρτιῶν καὶ πᾶν ἔλεος καὶ εἰρήνη καὶ ἐπιείκεια, ἔσται αὐτοῖς σωτηρία, φῶς ἀγαθόν, καὶ αὐτοὶ κληρονομήσουσιν τὴν γῆν καὶ πᾶσιν ὑμῖν τοῖς ἁμαρτωλοῖς οὐχ ὑπάρξει σωτηρία, ἀλλὰ ἐπὶ πάντας ὑμᾶς κατάλυσις, κατάρα."
											},
											"_id": "1792",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τοῖς ἐκλεκτοῖς φῶς καὶ χάρις καὶ εἰρήνη, καὶ αὐτοὶ κληρονομήσουσιν τὴν γῆν, ὑμῖν δὲ τοῖς ἀσεβέσιν ἔσται κατάρα."
										},
										"_id": "1793",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε δοθήσεται τοῖς ἐκλεκτοῖς φῶς καὶ χάρις, καὶ αὐτοὶ κληρονομήσουσιν τὴν γῆν. τότε δοθήσεται πᾶσιν τοῖς ἐκλεκτοῖς σοφία, καὶ πάντες οὗτοι ζήσονται, καὶ οὐ μὴ ἁμαρτήσονται ἔτι οὐ κατ᾽ ἀλήθειαν οὔτε κατὰ ὑπερηφανίαν, καὶ ἔσται ἐν ἀνθρώπῳ πεφωτισμένῳ φῶς καὶ ἀνθρώπῳ ἐπιστήμονι νόημα, καὶ οὐ μὴ πλημμελήσουσιν"
										},
										"_id": "1794",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "οὐδὲ μὴ ἁμάρτωσιν πάσας τὰς ἡμέρας τῆς ζωῆς αὐτῶν, καὶ οὐ μὴ ἀποθάνωσιν ἐν ὀργῇ θυμοῦ, ἀλλὰ τὸν ἀριθμὸν αὐτῶν ζωῆς ἡμερῶν πληρώσουσιν, καὶ ἡ ζωὴ αὐτῶν αὐξηθήσεται ἐν εἰρήνῃ, καὶ τὰ ἔτη τῆς χαρᾶς αὐτῶν πληθυνθήσεται ἐν ἀγαλλιάσει καὶ εἰρήνη αἰῶνος"
											},
											"_id": "1795",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἐν πάσαις ταῖς ἡμέραις τῆς ζωῆς αὐτῶν."
											},
											"_id": "1796",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "9"
								}
							],
							"_number": "5"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "Καὶ ἐγένετο"
											},
											"_id": "1797",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "οὗ ἂν"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ὅτε"
												}
											],
											"_id": "1798",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "ἐπληθύνθησαν οἱ υἱοὶ τῶν ἀνθρώπων,"
											},
											"_id": "1799",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἐν ἐκείναις ταῖς ἡμέραις"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1800",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "ἐγεννήθησαν"
											},
											"_id": "1801",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "αὐτοις"
												}
											],
											"_id": "1802",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "θυγατέρες"
											},
											"_id": "1803",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὡραῖαι καὶ καλαί."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ὡραῖαι."
												}
											],
											"_id": "1804",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἐθεάσαντο αὐτὰς οἱ ἄγγελοι υἱοὶ οὐρανοῦ"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1805",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ ἐπεθύμησαν αὐτάς"
											},
											"_id": "1806",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": ","
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "οἱ ἐγρήγοροι"
												}
											],
											"_id": "1807",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ εἶπαν πρὸς ἀλλήλους·"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ εἶπον πρὸς ἀλλήλους·"
												}
											],
											"_id": "1808",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Δεῦτε"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1809",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "ἐκλεξώμεθα ἑαυτοῖς γυναῖκας ἀπὸ"
											},
											"_id": "1810",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "τῶν θυγατέρων"
												}
											],
											"_id": "1811",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "τῶν ἀνθρώπων"
											},
											"_id": "1812",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": ","
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "τῆς γῆς."
												}
											],
											"_id": "1813",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ γεννήσομεν ἑαυτοῖς τέκνα."
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1814",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ εἶπεν Σεμειαζᾶς πρὸς αὐτούς, ὃς ἦν ἄρχων αὐτῶν·"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ εἶπε Σεμιαζᾶς ὁ ἄρχων αὐτῶν πρὸς αὐτούς"
												}
											],
											"_id": "1815",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "Φοβοῦμαι μὴ οὐ θελήσετε ποιῆσαι τὸ πρᾶγμα τοῦτο, καὶ ἔσομαι ἐγὼ μόνος ὀφειλέτης ἁμαρτίας μεγάλης."
											},
											"_id": "1816",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἀπεκρίθησαν οὖν αὐτῷ πάντες·"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ ἀπεκρίθησαν αὐτῷ πάντες καὶ εἶπον·"
												}
											],
											"_id": "1817",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Ὀμόσωμεν ὅρκῳ πάντες"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "Ὀμόσωμεν ἅπαντες ὅρκῳ"
												}
											],
											"_id": "1818",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ ἀναθεματίσωμεν πάντες ἀλλήλους"
											},
											"_id": "1819",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "τοῦ"
												}
											],
											"_id": "1820",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "μὴ ἀποστρέψαι τὴν γνώμην ταύτην,"
											},
											"_id": "1821",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "μέχρις οὗ ἂν τελέσωμεν αὐτὴν"
											},
											"_id": "1822",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ποιήσωμεν τὸ πρᾶγμα τοῦτο."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "."
												}
											],
											"_id": "1823",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τότε"
											},
											"_id": "1824",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὄμοσαν πάντες"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "πάντες ὥμοσαν"
												}
											],
											"_id": "1825",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "ὁμοῦ καὶ ἀνεθεμάτισαν ἀλλήλους"
											},
											"_id": "1826",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἐν αὐτῷ."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "."
												}
											],
											"_id": "1827",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "ἦσαν δὲ οὗτοι διακόσιοι οἱ καταβάντες ἐν ταῖς ἡμέραις Ἰάρεδ εἰς τὴν κορυφὴν τοῦ Ἑρμονιεὶμ ὄρους,"
												},
												{
													"_option": "1",
													"_mss": "Gizeh "
												}
											],
											"_id": "1828",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "καὶ ἐκάλεσαν τὸ ὄρος Ἑρμώμ,"
												},
												{
													"_option": "1",
													"_mss": "Gizeh "
												}
											],
											"_id": "1829",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "καθότι ὤμοσαν καὶ ἀνεθεμάτισαν ἀλλήλους ἐν αὐτῷ."
												},
												{
													"_option": "1",
													"_mss": "Gizeh "
												}
											],
											"_id": "1830",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ ταῦτα τὰ ὀνόματα τῶν ἀρχόντων αὐτῶν·"
											},
											"_id": "1831",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Σεμιαζά, οὗτος ἦν ἄρχων αὐτῶν· Ἀραθάκ, Κιμβρά, Σαμμανή, Δανειήλ, Ἀρεαρώς, Σεμιήλ, Ἰωμειήλ, Χωχαριήλ, Ἐζεκιήλ, Βατριήλ, Σαθιήλ, Ἀτριήλ, Ταμιήλ, Βαρακιήλ, Ἀνανθνά, Θωνιήλ, Ῥαμιήλ, Ἀσέαλ, Ῥακειήλ, Τουριήλ."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "αʹ Σεμιαζάς, ὁ ἄρχων αὐτῶν· βʹ Ἀταρκούφ, γʹ Ἀρακιήλ, δʹ Χωβαβιήλ, εʹ Ὁραμμαμή, Ϛʹ Ῥαμιήλ, ζʹ Σαμψίχ, ηʹ Ζακιήλ, θʹ Βαλκιήλ, ιʹ Ἀζαλζήλ, ιαʹ Φαρμαρός, ιβʹ Ἀμαριήλ, ιγʹ Ἀναγημάς, ιδʹ Θαυσαήλ, ιεʹ Σαμιήλ, ιϚʹ Σαρινᾶς, ιζʹ Εὐμιήλ, ιηʹ Τυριήλ, ιθʹ Ἰουμιήλ, κʹ Σαριήλ."
												}
											],
											"_id": "1832",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "7"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "οὗτοι εἰσιν ἀρχαὶ αὐτῶν οἱ (ἐπὶ) δέκα."
											},
											{
												"_option": "1",
												"_mss": "Syncellus "
											}
										],
										"_id": "1833",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								}
							],
							"_number": "6"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Καὶ"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "Οὗτοι καὶ οἱ λοιποὶ πάντες ἐν τῷ χιλιοστῷ ἑκατοστῷ ἑβδομηκοστῷ ἔτει τοῦ κόσμου"
												}
											],
											"_id": "1834",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "ἔλαβον ἑαυτοῖς γυναῖκες·"
											},
											"_id": "1835",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἕκαστος αὐτῶν ἐξελέξαντο ἑαυτοῖς γυναῖκας,"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1836",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ ἤρξαντο"
											},
											"_id": "1837",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "εἰσπορεύεσθαι πρὸς αὐτὰς καὶ"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1838",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "μιαίνεσθαι ἐν αὐταῖς·"
											},
											"_id": "1839",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἐδίδαξαν αὐτὰς φαρμακείας καὶ ἐπαοιδὰς καὶ ῥιζοτομίας, καὶ τὰς βοτάνας ἐδήλωσαν αὐταῖς."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ἕως τοῦ κατακλυσμοῦ."
												}
											],
											"_id": "1840",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "αἱ δὲ ἐν γαστρὶ λαβοῦσαι ἐτέκοσαν"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ ἔτεκον αὐτοῖς γένη τρία· πρῶτον"
												}
											],
											"_id": "1841",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "γίγαντας μεγάλους"
											},
											"_id": "1842",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἐκ πηχῶν τρισχιλίων,"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "οἱ δε Γίγαντες ἐτέκνωσαν Ναφηλείμ, καὶ τοῖς Ναφελεὶμ ἐγεννήθησαν Ἐλιούδ. Καὶ ἦσαν αὐξανόμενοι κατὰ τὴν μεγαλειότητα αὐτῶν. καὶ ἐδίδαξαν [ἑαυτοὺς καὶ] τὰς γυναῖκας ἑαυτῶν φαρμακείας καὶ ἐπαοιδάς."
												}
											],
											"_id": "1843",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "οἵτινες κατησθίοσαν τοὺς κόπους τῶν ἀνθρώπων. ὡς δὲ οὐκ ἐδυνήθησαν αὐτοῖς οἱ ἄνθρωποι ἐπιχορηγεῖν,"
											},
											{
												"_option": "1",
												"_mss": "Syncellus "
											}
										],
										"_id": "1844",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "οἱ γίγαντες ἐτόλμησαν ἐπ᾽ αὐτούς, καὶ κατησθίοσαν τοὺς ἀνθρώπους."
											},
											{
												"_option": "1",
												"_mss": "Syncellus "
											}
										],
										"_id": "1845",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἤρξαντο ἁμαρτάνειν ἐν τοῖς πετεινοῖς καὶ τοῖς θηρίοις καὶ ἑρπετοῖς καὶ τοῖς ἰχθύσιν,"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1846",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἀλλήλων τὰς σάρκας κατεσθίειν,"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1847",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ τὸ αἷμα ἔπινον."
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1848",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τότε ἡ γῆ ἐνέτυχεν κατὰ τῶν ἀνόμων."
											},
											{
												"_option": "1",
												"_mss": "Syncellus "
											}
										],
										"_id": "1849",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								}
							],
							"_number": "7"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Ἐδίδαξεν τοὺς ἀνθρώπους Ἀζαὴλ"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "Πρῶτος Ἀζαὴλ ὁ δέκατος τῶν ἀρχόντων ἐδίδαξε"
												}
											],
											"_id": "1850",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "μαχαίρας ποιεῖν"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ποιεῖν μαχαίρας"
												}
											],
											"_id": "1851",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ὅπλα καὶ ἀσπίδας"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1852",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ θώρακας,"
											},
											"_id": "1853",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "διδάγματα ἀγγέλων, καὶ ὑπέδειξεν αὐτοῖς"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ πᾶν σκεῦος πολεμικόν, καὶ"
												}
											],
											"_id": "1854",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "τὰ μέταλλα"
											},
											"_id": "1855",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ τὴν ἐργασίαν αὐτῶν,"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "τῆς γῆς καὶ τὸ χρυσίον πῶς ἐργάσωνται,"
												}
											],
											"_id": "1856",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ψέλια καὶ κόσμους καὶ στίβεις καὶ τὸ καλλιβλέφαρον καὶ παντοίους λίθους ἐκλεκτοὺς"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ ποιήσωσιν αὐτὰ κόσμια ταῖς γυναιξί, καὶ τὸν ἄργυρον ἔδειξε δὲ αὐτοῖς καὶ τὸ στίλβειν καὶ τὸ καλλωπίζειν καὶ τοὺς ἐκλεκτοὺς λίθους"
												}
											],
											"_id": "1857",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ τὰ βαφικά."
											},
											"_id": "1858",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ ἐποίησαν ἑαυτοῖς οἱ ὑιοὶ τῶν ἀνθρώπων καὶ ταῖς θυγατράσιν αὐτῶν, καὶ παρέβησαν καὶ ἐπλάνησαν τοὺς ἁγίους."
												}
											],
											"_id": "1859",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "καὶ ἐγένετο ἀσέβεια πολλή"
											},
											"_id": "1860",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": ","
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ἐπὶ τῆς γῆς,"
												}
											],
											"_id": "1861",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἐπόρνευσαν καὶ ἀπεπλανήθησαν"
												},
												{
													"_option": "1",
													"_mss": "Syncellus "
												}
											],
											"_id": "1862",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "καὶ ἠφανίσθησαν ἐν πάσαις ταῖς ὁδοῖς αὐτῶν."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "καὶ ἠφάνισαν τὰς ὁδοὺς αὐτῶν."
												}
											],
											"_id": "1863",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ἔτι δὲ καὶ ὁ πρώταρχος αὐτῶν"
												}
											],
											"_id": "1864",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "Σεμιαζᾶς ἐδίδαξεν"
											},
											"_id": "1865",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἐπαοιδὰς καὶ ῥιζοτομίας· Ἀρμαρὼς"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "εἶναι ὀργὰς κατὰ τοῦ νοός, καὶ ῥίζας βοτανῶν τῆς γῆς. ὁ δὲ ἑνδέκατος Φαρμαρὸς ἐδίδαξε φαρμακείας, ἐπαοιδάς, σοφίας, καὶ"
												}
											],
											"_id": "1866",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Syncellus ",
												"__text": "ἐπαοιδῶν"
											},
											"_id": "1867",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "λυτήριον·"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "λυτήρια·"
												}
											],
											"_id": "1868",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh Syncellus ",
													"__text": "Βαρακιὴλ ἀστρολογίας·"
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ὁ ἕνατος ἐδίδαξεν ἀστροκοπίαν· ὁ δὲ τέταρτος έδίδαξεν ἀστρολογίαν, ὁ δὲ ὄγδοος έδίδαξεν ἀεροσκοπίαν·"
												}
											],
											"_id": "1869",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "Χωχιὴλ τὰ σημειωτικά· Σαθιὴλ ἀστεροσκοπίαν· Σεριὴλ σεληναγωγίας."
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "ὁ δὲ τρίτος ἐδίδαξε τὰ σημεῖα τῆς γῆς  ὁ δὲ ἕβδομος ἐδίδαξε τὰ σημεῖα τοῦ ἡλίου  ὁ δὲ εἰκοστὸς ἐδίδαξε τὰ σημεῖα τῆς σελήνης."
												}
											],
											"_id": "1870",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Syncellus ",
													"__text": "πάντες οὗτοι ἤρξαντο ἀνακαλύπτειν τὰ μυστήρια ταῖς γυναιξὶν αὐτῶν καὶ τοῖς τέκνοις αὐτῶν. Μετὰ δὲ ταῦτα ἤρξαντο οἱ γίγαντες κατεσθίειν τὰς σάρκας τῶν ἀνθρώπων."
												}
											],
											"_id": "1871",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "τῶν οὖν ἀνθρώπων ἀπολλυμένων ἡ βοὴ εἰς οὐρανοὺς ἀνέβη."
											},
											{
												"_option": "1",
												"_mss": "Syncellus ",
												"__text": "καὶ ἤρξαντο οἱ ἄνθρωποι ἐλαττοῦσθαι ἐπὶ τῆς γῆς. Οἱ δὲ λοιποὶ ἐβόησαν εἰς τὸν οὐρανὸν περὶ τῆς κακώσεως αὐτῶν, λέγοντες εἰσενεχθῆναι τὸ μνημόσυνον αὐτῶν ἐνώπιον Κυρίου."
											},
											{
												"_option": "2",
												"_mss": "Syncellus2 ",
												"__text": "Τότε ἐβόησαν οἱ ἄνθρωποι εἰς τὸν οὐρανὸν λέγοντες Εἰσαγάγετε τὴν κρίσιν ἡμῶν πρὸς τὸν ὕπιστον, καὶ τὴν ἀπώλειαν ἡμῶν ἐνώπιον τῆς δόξης τῆς μεγάλης, ἐνώπιον τοῦ κυρίου τῶν κυρίων πάντων τῇ μεγαλωσύνῃ."
											}
										],
										"_id": "1872",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								}
							],
							"_number": "8"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Τότε παρακύψαντες Μιχαὴλ καὶ Οὐριὴλ καὶ Ῥαφαὴλ καὶ Γαβριήλ, οὗτοι ἐκ τοῦ οὐρανοῦ ἐθεάσαντο αἷμα πολὺ ἐκχυννόμενον ἐπὶ τῆς γῆς·"
										},
										"_id": "1873",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶπαν πρὸς ἀλλήλους φωνὴ βοώντων ἐπὶ τῆς γῆς μέχρι πυλῶν τοῦ οὐρανοῦ."
										},
										"_id": "1874",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐντυγχάνουσιν αἱ ψυχαὶ τῶν ἀνθρώπων λεγόντων· Εἰσαγάγετε τὴν κρίσιν ἡμῶν πρὸς τὸν ὕψιστον."
										},
										"_id": "1875",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶπαν τῷ κυρίῳ· Σὺ εἶ κύριος τῶν κυρίων καὶ ὁ θεὸς τῶν θεῶν καὶ βασιλεὺς τῶν αἰώνων· ὁ θρόνος τῆς δόξης σου εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος, καὶ τὸ ὄνομά σου τὸ ἅγιον καὶ μέγα καὶ εὐλογητὸν εἰς πάντας τοὺς αἰῶνας. τότε ὁ ὕψιστος ἐκέλευσε τοῖς ἁγίοις ἀρχαγγέλοις, καὶ ἔδησαν τοὺς ἐξάρχους αὐτῶν καὶ ἔβαλον αὐτοὺς εἰς τὴν ἄβυσσον, ἕως τῆς κρίσεως."
										},
										"_id": "1876",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "σὺ γὰρ ἐποίησας τὰ πάντα, καὶ πᾶσαν τὴν ἐξουσίαν ἔχων, καὶ πάντα ἐνώπιόν σου φανερὰ καὶ ἀκάλυπτα."
										},
										"_id": "1877",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πάντα σὺ ὁρᾷς ἃ ἐποίησεν Ἀζαὴλ, ὃς ἐδίδαξεν πάσας τὰς ἀδικίας ἐπὶ τῆς γῆς καὶ ἐδήλωσεν τὰ μυστήρια τοῦ αἰῶνος τὰ ἐν τῷ οὐρανῷ ἃ ἐπιτηδεύουσιν καὶ ἔγνωσαν ἄνθρωποι,"
										},
										"_id": "1878",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ Σεμιαζᾶς, ᾧ τὴν ἐξουσίαν ἔδωκας ἄρχειν τῶν σὺν αὐτῷ ἅμα ὄντων."
										},
										"_id": "1879",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐπορεύθησαν πρὸς τὰς θυγατέρας τῶν ἀνθρώπων τῆς γῆς καὶ συνεκοιμήθησαν αὐταῖς καὶ ἐμιάνθησαν, καὶ ἐδήλωσαν αὐταῖς πάσας τὰς ἁμαρτίας."
										},
										"_id": "1880",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ αἱ γυναῖκες ἐγέννησαν τιτᾶνας, ὑφ᾽ ὧν ὅλη ἡ γῆ ἐπλήσθη αἵματος καὶ ἀδικίας."
										},
										"_id": "1881",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ νῦν ἰδοὺ βοῶσιν αἱ ψυχαὶ τῶν τετελευτηκότων καὶ ἐντυγχάνουσιν μέχρι τῶν πυλῶν τοῦ οὐρανοῦ, καὶ ἀνέβη ὁ στεναγμὸς αὐτῶν καὶ οὐ δύναται ἐξελθεῖν ἀπὸ προσώπου τῶν ἐπὶ τῆς γῆς γινομένων ἀνομημάτων."
										},
										"_id": "1882",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ σὺ πάντα οἶδας πρὸ τοῦ αὐτὰ γενέσθαι, καὶ σὺ ὁρᾷς ταῦτα καὶ ἐᾷς αὐτούς, καὶ οὐδὲ ἡμῖν λέγεις τί δεῖ ποιεῖν αὐτοὺς περὶ τούτων."
										},
										"_id": "1883",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								}
							],
							"_number": "9"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Τότε Ὕψιστος εἶπεν περὶ τούτων, ὁ μέγας Ἅγιος, καὶ ἐλάλησεν καὶ εἶπεν καὶ ἔπεμψεν Ἰστραὴλ πρὸς τὸν υἱὸν Λέμεχ·"
										},
										"_id": "1884",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Εἶπον αὐτῷ ἐπὶ τῷ ἐμῷ ὀνόματι Κρύψον σεαυτόν, καὶ δήλωσον αὐτῷ τέλος ἐπερχόμενον, ὅτι ἡ γῆ ἀπόλλυται πᾶσα, καὶ κατακλυσμὸς μέλλει γίνεσθαι πάσης τῆς γῆς καὶ ἀπολέσει πάντα ὅσα ἐστιν ἐν αὐτῇ."
										},
										"_id": "1885",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ δίδαξον αὐτὸν ὅπως ἐκφύγη, καὶ μενεῖ τὸ σπέρμα αὐτοῦ εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος."
										},
										"_id": "1886",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τῷ Ῥαφαὴλ εἶπεν· Δῆσον τὸν Ἀζαὴλ ποσὶν καὶ χερσίν, καὶ βάλε αὐτὸν εἰς τὸ σκότος, καὶ ἄνοιξον τὴν ἔρημον τὴν οὖσαν ἐν τῷ Δαδουὴλ κἀκεῖ βάλε αὐτόν,"
										},
										"_id": "1887",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὑπόθες αὐτῷ λίθους τραχεῖς καὶ ὀξεῖς καὶ ἐπικάλυψον αὐτῷ τὸ σκότος. καὶ οἰκησάτω ἐκεῖ εἰς τοὺς αἰῶνας, καὶ τὴν ὄψιν αὐτοῦ πώμασον καὶ φῶς μὴ θεωρείτω·"
										},
										"_id": "1888",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐν τῇ ἡμέρᾳ τῆς μεγάλης τῆς κρίσεως ἀπαχθήσεται εἰς τὸν ἐνπυρισμόν."
										},
										"_id": "1889",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἰαθήσεται ἡ γῆ, ἣν ἠφάνισαν οἱ ἄγγελοι, καὶ τὴν ἴασιν τῆς γῆς δήλωσον, ἵνα ἰάσωνται τὴν πληγήν, ἵνα μὴ ἀπόλωνται πάντες οἱ υἱοὶ τῶν ἀνθρώπων ἐν τῷ μυστηρίῳ ὅλῳ ᾧ ἐπέταξαν οἱ ἐγρήγοροι καὶ ἐδίδαξαν τοὺς υἱοὺς αὐτῶν,"
										},
										"_id": "1890",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἠρημώθη πᾶσα ἡ γῆ ἀφανισθεῖσα ἐν τοῖς ἔργοις τῆς διδασκαλίας Ἀζαήλ· καὶ ἐπ᾽ αὐτῷ γράψον τὰς ἁμαρτίας πάσας."
										},
										"_id": "1891",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τῷ Γαβριὴλ εἶπεν ὁ κύριος· Πορεύου ἐπὶ τοὺς μαζηρέους, ἐπὶ τοὺς κιβδήλους καὶ τοὺς υἱοὺς τῆς πορνείας, καὶ ἀπόλεσον τοὺς υἱοὺς τῶν ἐγρηγόρων ἀπὸ τῶν ἀνθρώπων· πέμψον αὐτοὺς ἐν πολέμῳ ἀπωλείας. μακρότης γὰρ ἡμερῶν οὐκ ἔστιν αὐτῶν"
										},
										"_id": "1892",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πᾶσα ἐρώτησις οὐκ ἔσται τοῖς πατράσιν αὐτῶν καὶ περὶ αὐτῶν, ὅτι ἐλπίζουσιν ζῆσαι ζωὴν αἰώνιον, καὶ ὅτι ζήσεται ἕκαστος αὐτῶν ἔτη πεντακόσια."
										},
										"_id": "1893",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶπεν Μιχαήλ· Πορεύου καὶ δήλωσον Σεμιαζᾷ καὶ τοῖς λοιποῖς τοῖς σὺν αὐτῷ ταῖς γυναιξὶν μιγεῖσιν, μιανθῆναι ἐν αὐταῖς ἐν ἀκαθαρσίᾳ αὐτῶν·"
										},
										"_id": "1894",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὅταν κατασφαγῶσιν οἱ υἱοὶ αὐτῶν καὶ ἴδωσιν τὴν ἀπώλειαν τῶν ἀγαπητῶν, καὶ δῆσον αὐτοὺς ἑβδομήκοντα γενεὰς εἰς τὰς νάπας τῆς γῆς μέχρι ἡμέρας κρίσεως αὐτῶν καὶ συντελεσμοῦ, ἕως τελεσθῇ τὸ κρίμα τοῦ αἰῶνος τῶν αἰώνων."
										},
										"_id": "1895",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπαχθήσονται εἰς τὸ χάος τοῦ πυρὸς καὶ εἰς τὴν βάσανον καὶ εἰς τὸ δεσμωτήριον συνκλείσεως αἰῶνος."
										},
										"_id": "1896",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὃς ἂν κατακαυθῇ καὶ ἀφανισθῇ ἀπὸ τοῦ νῦν, μετ᾽ αὐτῶν ὁμοῦ δεθήσονται μέχρι τελειώσεως γενεᾶς."
										},
										"_id": "1897",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἀπόλεσον πάντα τὰ πνεύματα τῶν κιβδήλων καὶ τοὺς υἱοὺς τῶν ἐγρηγόρων διὰ τὸ ἀδικῆσαι τοὺς ἀνθρώπους."
										},
										"_id": "1898",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπόλεσον τὴν ἀδικίαν πᾶσαν ἀπὸ τῆς γῆς, καὶ πᾶν ἔργον πονηρίας ἐκλειπέτω, καὶ ἀναφανήτω τὸ φυτὸν τῆς δικαιοσύνης καὶ τῆς ἀληθείας εἰς τοὺς αἰῶνας· μετὰ χαρᾶς φυτευθήσεται."
										},
										"_id": "1899",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ νῦν πάντες οἱ δίκαιοι ἐκφεύξονται, καὶ ἔσονται ζῶντες ἕως γεννήσωσιν χιλιάδας, καὶ πᾶσαι αἱ ἡμέραι νεότητος αὐτῶν, καὶ τὰ σάββατα αὐτῶν μετὰ εἰρήνης πληρώσουσιν."
										},
										"_id": "1900",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "17"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἐργασθήσεται πᾶσα ἡ γῆ ἐν δικαιοσύνῃ καὶ φυτευθήσεται δένδρον ἐν αὐτῇ, καὶ πλησθήσεται εὐλογίας."
										},
										"_id": "1901",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "18"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πάντα τὰ δένδρα τῆς γῆς ἀγαλλιάσονται· φυτευθήσεται, καὶ ἔσονται φυτεύοντες ἀμπέλους, καὶ ἡ ἄμπελος ἣν ἂν φυτεύσωσιν, ποιήσουσιν προχοῦς οἴνου χιλιάδας καὶ σπόρου ποιήσει καθ᾽ ἕκαστον μέτρον, ἐλαίας ποιήσει ἀνὰ βάτους δέκα."
										},
										"_id": "1902",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "19"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ σὺ καθάρισον τὴν γῆν ἀπὸ πάσης ἀκαθαρσίας καὶ ἀπὸ πάσης ἀδικίας καὶ ἀπὸ πάσης ἁμαρτίας καὶ ἀσεβείας, καὶ πάσας τὰς ἀκαθαρσίας τὰς γινομένας ἐπὶ τῆς γῆς ἐξάλειψον."
										},
										"_id": "1903",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "20"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἔσονται πάντες λατρεύοντες οἱ λαοὶ καὶ εὐλογοῦντες πάντες ἐμοὶ καὶ προσκυνοῦντες."
										},
										"_id": "1904",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "21"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ καθαρισθήσεται πᾶσα ἡ γῆ ἀπὸ παντὸς μιάσματος καὶ ἀπὸ πάσης ἀκαθαρσίας καὶ ὀργῆς καὶ μάστιγος, καὶ οὐκέτι πέμψω ἐπ᾽ αὐτοὺς εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος."
										},
										"_id": "1905",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "22"
								}
							],
							"_number": "10"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τότε ἀνοίξω τὰ ταμεῖα τῆς εὐλογίας τὰ ὄντα ἐν τῷ οὐρανῷ, καὶ κατενεγκεῖν αὐτὰ ἐπὶ τὰ ἔργα, ἐπὶ τὸν κόπον τῶν υἱῶν τῶν ἀνθρώπων."
										},
										"_id": "1906",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τότε ἀλήθεια καὶ εἰρήνη κοινωνήσουσιν ὁμοῦ εἰς πάσας τὰς ἡμέρας τοῦ αἰῶνος καὶ εἰς πάσας τὰς γενεὰς τῶν ἀνθρώπων."
										},
										"_id": "1907",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								}
							],
							"_number": "11"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πρὸ τούτων τῶν λόγων ἐλήμφθη Ἑνώχ, καὶ οὐδεὶς τῶν ἀνθρώπων ἔγνω ποῦ ἐλήμφθη καὶ ποῦ ἐστιν καὶ τί ἐγένετο αὐτῷ."
										},
										"_id": "1908",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὰ ἔργα αὐτοῦ μετὰ τῶν ἐγρηγόρων, καὶ μετὰ τῶν ἁγίων αἱ ἡμέραι αὐτοῦ."
										},
										"_id": "1909",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἑστὼς ἤμην Ἑνὼχ εὐλογῶν τῷ κυρίῳ τῆς μεγαλωσύνης, τῷ βασιλεῖ τῶν αἰώνων. καὶ ἰδοὺ οἱ ἐγρήγοροι τοῦ ἁγίου τοῦ μεγάλου ἐκάλουν με·"
										},
										"_id": "1910",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ἑνὼχ, ὁ γραμματεὺς τῆς δικαιοσύνης, πορεύου καὶ εἶπε τοῖς ἐγρηγόροις τοῦ οὐρανοῦ οἵτινες ἀπολιπόντες τὸν οὐρανὸν τὸν ὑψηλόν, τὸ ἁγίασμα τῆς στάσεως τοῦ αἰῶνος, μετὰ τῶν γυναικῶν ἐμιάνθησαν, καὶ ὥσπερ οἱ υἱοὶ τῆς γῆς ποιοῦσιν, οὕτως καὶ αὐτοὶ ποιοῦσιν, καὶ ἔλαβον ἑαυτοῖς γυναῖκας. Ἀφανισμὸν μέγαν ἠφανίσατε τὴν γῆν,"
										},
										"_id": "1911",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὐκ ἔσται ὑμῖν εἰρήνη οὔτε ἄφεσις. καὶ περὶ ὧν χαίρουσιν τῶν υἱῶν αὐτῶν,"
										},
										"_id": "1912",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τὸν φόνον τῶν ἀγαπητῶν αὐτῶν ὄψονται, καὶ ἐπὶ τῇ ἀπωλείᾳ τῶν υἱῶν αὐτῶν στενάξουσιν καὶ δεηθήσονται εἰς τὸν αἰῶνα, καὶ οὐκ αὐτοῖς ἔσται εἰς ἔλεον καὶ εἰρήνην."
										},
										"_id": "1913",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								}
							],
							"_number": "12"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ὁ δὲ Ἑνώχ τῷ Ἀζαὴλ εἶπεν· Πορεύου· οὐκ ἔσται σοι εἰρήνη. κρίμα μέγα ἐξῆλθεν κατὰ σοῦ δῆσαί σε,"
										},
										"_id": "1914",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀνοχὴ καὶ ἐρώτησίς σοι οὐκ ἔσται περὶ ὧν ἔδειξας ἀδικημάτων καὶ περὶ πάντων τῶν ἔργων τῶν ἀσεβειῶν καὶ τῆς ἀδικίας καὶ τῆς ἁμαρτίας, ὅσα ὑπέδειξας τοῖς ἀνθρώποις."
										},
										"_id": "1915",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε πορευθεὶς εἴρηκα πᾶσιν αὐτοῖς, καὶ αὐτοὶ πάντες ἐφοβήθησαν, καὶ̀ ἔλαβεν αὐτοὺς τρόμος καὶ φόβος."
										},
										"_id": "1916",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἠρώτησαν ὅπως γράψω αὐτοῖς ὑπομνήματα ἐρωτήσεως ἵνα γένηται αὐτοῖς ἄφεσις, καὶ ἵνα ἐγὼ ἀναγνῶ αὐτοῖς τὸ ὑπόμνημα τῆς ἐρωτήσεως ἐνώπιον κυρίου τοῦ οὐρανοῦ, 5 ὅτι αὐτοὶ οὐκ ἔτι δύνανται λαλῆσαι, οὐδὲ ἀπᾶραι αὐτῶν τοὺς ὀφθαλμοὺς εἰς τὸν οὐρανὸν ἀπὸ αἰσχύνης περὶ ὧν ἡμαρτήκεισαν καὶ κατεκρίθησαν."
										},
										"_id": "1917",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἔγραψα τὸ ὑπόμνημα τῆς ἐρωτήσεως αὐτῶν καὶ τὰς δεήσεις περὶ τῶν πνευμάτων αὐτῶν καὶ περὶ ὧν δέονται, ὅπως αὐτῶν γένωνται ἄφεσις καὶ μακρότης."
										},
										"_id": "1918",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πορευθεὶς ἐκάθισα ἐπὶ τῶν ὑδάτων Δὰν ἐν γῇ Δάν, ἥτις ἐστιν ἐκ δεξιῶν Ἑρμωνειεὶμ δύσεως· ἀνεγίγνωσκον τὸ ὑπόμνημα τῶν δεήσεων αὐτῶν."
										},
										"_id": "1919",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὡς ἐκοιμήθην, καὶ ἰδοὺ ὄνειροι ἐπ᾽ ἐμὲ ἦλθον καὶ ὁράσεις ἐπ᾽ ἐμὲ ἐπέπιπτον, καὶ ἴδον ὁράσεις ὀργῆς, καὶ ἦλθεν φωνὴ λέγουσα· Εἶπον τοῖς υἱοῖς τοῦ οὐρανοῦ τοῦ ἐλέγξαι αὐτοὺς."
										},
										"_id": "1920",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἔξυπνος γενόμενος ἦλθον πρὸς αὐτοὺς, καὶ πάντες συνηγμένοι ἐκάθηντο πενθοῦντες ἐν Ἐβελσατά, ἥτις ἐστὶν ἀνὰ μέσον τοῦ Λιβάνου καὶ Σενισήλ, περικεκαλυμμένοι τὴν ὄψιν."
										},
										"_id": "1921",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐνώπιον αὐτῶν καὶ ἀνήγγειλα αὐτοῖς πάσας τὰς ὁράσεις ἃς εἶδον κατὰ τοὺς ὕπνους, καὶ ἠρξάμην λαλεῖν τοὺς λόγους τῆς δικαιοσύνης, ἐλέγχων τοὺς ἐγρηγόρους τοῦ οὐρανοῦ."
										},
										"_id": "1922",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								}
							],
							"_number": "13"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Βίβλος λόγων δικαιοσύνης καὶ ἐλέγξεως ἐγρηγόρων τῶν ἀπὸ τοῦ αἰῶνος, κατὰ τὴν ἐντολὴν τοῦ ἁγίου τοῦ μεγάλου ἐν ταύτῃ τῇ ὁράσει."
										},
										"_id": "1923",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ἐγὼ εἶδον κατὰ τοὺς ὕπνους μου ὃ νῦν λέγω ἐν γλώσσῃ σαρκίνῃ ἐν τῷ πνεύματι τοῦ στόματί μου, ὃ ἔδωκεν ὁ μέγας τοῖς ἀνθρώποις λαλεῖν ἐν αὐτοῖς καὶ νοήσει καρδίας·"
										},
										"_id": "1924",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὃς ἔκτισεν καὶ ἔδωκεν ἐλέγξασθαι ἐγρηγόρους τοὺς υἱοὺς τοῦ οὐρανοῦ."
										},
										"_id": "1925",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ἐγὼ τὴν ἐρώτησιν ὑμῶν τῶν ἀγγέλων ἔγραψα, καὶ ἐν τῇ ὁράσει μου τοῦτο ἐδείχθη· καὶ οὔτε ἡ ἐρώτησις ὑμῶν παρεδέχθη,"
										},
										"_id": "1926",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἵνα μηκέτι εἰς τὸν οὐρανὸν ἀναβῆτε ἐπὶ πάντας τοὺς αἰῶνας, καὶ ἐν τοῖς δεσμοῖς τῆς γῆς ἐρρέθη δῆσαι ὑμᾶς εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος,"
										},
										"_id": "1927",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἵνα περὶ τούτων ἴδητε τὴν ἀπώλειαν τῶν υἱῶν ὑμῶν τῶν ἀγαπητῶν, καὶ ὅτι οὐκ ἔσται ὑμῖν ὄνησις αὐτῶν, ἀλλὰ πεσοῦνται ἐνώπιον ὑμῶν ἐν μαχαίρᾳ."
										},
										"_id": "1928",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἡ ἐρώτησις ὑμῶν περὶ αὐτῶν οὐκ ἔσται οὐδὲ περὶ ὑμῶν· καὶ ὑμεῖς κλαίοντες καὶ δεόμενοι καὶ μὴ λαλοῦντες πᾶν ῥῆμα ἀπὸ τῆς γραφῆς ἧς ἔγραψα."
										},
										"_id": "1929",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐμοὶ ἐφ᾽ ὁράσει οὕτως ἐδείχθη· ἰδοὺ νεφέλαι ἐν τῇ ὁράσει ἐκάλουν καὶ ὁμίχλαι με ἐφώνουν, καὶ διαδρομαὶ τῶν ἀστέρων καὶ διαστραπαί με κατεσπούδαζον καὶ ἐθορύβαζόν με, καὶ ἄνεμοι ἐν τῇ ὁράσει μου ἐξεπέταπασάν με"
										},
										"_id": "1930",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐπῆράν με ἄνω καὶ εἰσήνεγκάν με εἰς τὸν οὐρανόν, καὶ εἰσῆλθον μέχρις ἤγγισα τείχους οἰκοδομῆς ἐν λίθοις χαλάζης καὶ γλώσσης πυρὸς κύκλῳ αὐτῶν· καὶ ἤρξαντο ἐκφοβεῖν με."
										},
										"_id": "1931",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἰσῆλθον εἰς τὰς γλώσσας τοῦ πυρός, καὶ ἤγγισα εἰς οἶκον μέγαν οἰκοδομημένον ἐν λίθοις χαλάζης, καὶ οἱ τοῖχοι τοῦ οἴκου ὡς λιθόπλακες, καὶ πᾶσαι ἦσαν ἐκ χιόνος, καὶ ἐδάφη χιονικά,"
										},
										"_id": "1932",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ αἱ στέγαι ὡς διαδρομαὶ ἀστέρων καὶ ἀστραπαί, καὶ μεταξὺ αὐτῶν χερουβὶν πύρινα, καὶ οὐρανὸς αὐτῶν ὕδωρ,"
										},
										"_id": "1933",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πῦρ φλεγόμενον κύκλῳ τῶν τειχῶν, καὶ θύραι πυρὶ καιόμεναι."
										},
										"_id": "1934",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "εἰσῆλθον εἰς τὸν οἶκον ἐκεῖνον, θερμὸν ὡς πῦρ καὶ ψυχρὸν ὡς χιών, καὶ πᾶσα τροφὴ ζωῆς οὐκ ἦν ἐν αὐτῷ· φόβος με ἐκάλυψεν καὶ τρόμος με ἔλαβεν."
										},
										"_id": "1935",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἤμην σειόμενος καὶ τρέμων, καὶ ἔπεσον. ἐθεώρουν ἐν τῇ ὁράσει μου,"
										},
										"_id": "1936",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἰδοὺ ἄλλη θύρα ἀνεῳγμένη κατέναντί μου, καὶ ὁ οἶκος μείζων τούτου, καὶ ὅλος οἰκοδομημένος ἐν γλώσσαις πυρός,"
										},
										"_id": "1937",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὅλος διαφέρων ἐν δόξῃ καὶ ἐν τιμῇ καὶ ἐν μεγαλωσύνῃ, ὥστε μὴ δύνασθαί με ἐξειπεῖν ὑμῖν περὶ τῆς δόξης καὶ περὶ τῆς μεγαλωσύνης αὐτοῦ."
										},
										"_id": "1938",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τὸ ἔδαφος αὐτοῦ ἦν πυρός, τὸ δὲ ἀνώτερον αὐτοῦ ἦσαν ἀστραπαὶ καὶ διαδρομαὶ ἀστέρων, καὶ ἡ στέγη αὐτοῦ ἦν πῦρ φλέγον."
										},
										"_id": "1939",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "17"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐθεώρουν δὲ καὶ εἶδον θρόνον ὑψηλόν, καὶ τὸ εἶδος αὐτοῦ ὡσεὶ κρυστάλλινον, καὶ τροχὸς ὡς ἡλίου λάμποντος καὶ ὄρος χερουβίν."
										},
										"_id": "1940",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "18"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὑποκάτω τοῦ θρόνου ἐξεπορεύοντο ποταμοὶ πυρὸς φλεγόμενοι, καὶ οὐκ ἐδυνάσθην ἰδεῖν."
										},
										"_id": "1941",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "19"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἡ δόξα ἡ μεγάλη ἐκάθητο ἐπ᾽ αὐτῷ· τὸ περιβόλαιον αὐτοῦ ὡς εἶδος ἡλίου, λαμπρότερον καὶ λευκότερον πάσης χιόνος."
										},
										"_id": "1942",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "20"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὐκ ἐδύνατο πᾶς ἄγγελος παρελθεῖν εἰς τὸν οἶκον τοῦτον καὶ ἰδεῖν τὸ πρόσωπον αὐτοῦ διὰ τὸ ἔντιμον καὶ ἔνδοξον, καὶ οὐκ ἐδύνατο πᾶσα σὰρξ ἰδεῖν αὐτοῦ"
										},
										"_id": "1943",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "21"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τὸ πῦρ φλεγόμενον κύκλῳ· καὶ πῦρ μέγα παρειστήκει αὐτῷ, καὶ οὐδεὶς ἐγγίζει αὐτῷ. κύκλῳ μυρίαι μυριάδες ἑστήκασιν ἐνώπιον αὐτοῦ, καὶ πᾶς λόγος αὐτοῦ ἔργον."
										},
										"_id": "1944",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "22"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οἱ ἅγιοι τῶν ἀγγέλων οἱ ἐγγίζοντες αὐτῷ οὐκ ἀποχωροῦσιν νυκτὸς οὔτε ἀφίστανται αὐτοῦ."
										},
										"_id": "1945",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "23"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "κἀγὼ ἤμην ἕως τούτου ἐπὶ πρόσωπόν μου βεβλημένος καὶ τρέμων, καὶ ὁ κύριος τῷ στόματι αὐτοῦ ἐκάλεσέν με καὶ εἶπέν μοι, Πρόσελθε ὧδε, Ἑνώχ, καὶ τὸν λόγον μου ἄκουσον."
										},
										"_id": "1946",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "24"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ προσελθών μοι εἷς τῶν ἁγίων ἤγειρέν με καὶ ἔστησέν με, καὶ προσήγαγέν με μέχρι τῆς θύρας· ἐγὼ δὲ τὸ πρόσωπόν μου κάτω ἔκυφον."
										},
										"_id": "1947",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "25"
								}
							],
							"_number": "14"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἀποκριθεὶς εἶπέν μοι, Ὁ ἄνθρωπος ὁ ἀληθινός, ἄνθρωπος τῆς ἀληθείας, ὁ γραμματεύς· καὶ τῆς φωνῆς αὐτοῦ ἤκουσα· μὴ φοβηθῇς, Ἑνώχ, ἄνθρωπος ἀληθινὸς καὶ γραμματεὺς τῆς ἀληθείας· πρόσελθε ὧδε, καὶ τῆς φωνῆς μου ἄκουσον."
										},
										"_id": "1948",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πορεύθητι καὶ εἶπε τοῖς πέμψασίν σε, Ἐρωτῆσαι ὑμᾶς ἔδει περὶ τῶν ἀνθρώπων, καὶ μὴ τοὺς ἀνθρώπους περὶ ὑμῶν."
										},
										"_id": "1949",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "διὰ τί ἀπελίπετε τὸν οὐρανὸν τὸν ὑψηλὸν τὸν ἅγιον τοῦ αἰῶνος, καὶ μετὰ τῶν γυναικῶν ἐκοιμήθητε καὶ μετὰ τῶν θυγατέρων τῶν ἀνθρώπων ἐμιάνθητε καὶ ἐλάβετε ἑαυτοῖς γυναῖκας; ὥσπερ υἱοὶ τῆς γῆς ἐποιήσατε καὶ ἐγεννήσατε ἑαυτοῖς τέκνα, υἱοὺς γίγαντας."
										},
										"_id": "1950",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὑμεῖς ἦτε ἅγιοι καὶ πνεύματα ζῶντα αἰώνια ἐν τῷ αἵματι τῶν γυναικῶν ἐμιάνθητε, καὶ ἐν αἵματι σαρκὸς ἐγεννήσατε καὶ ἐν αἵματι ἀνθρώπων ἐπεθυμήσατε. καθὼς καὶ αὐτοὶ ποιοῦσιν σάρκα καὶ αἷμα, οἵτινες ἀποθνήσκουσιν καὶ ἀπόλλυνται."
										},
										"_id": "1951",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "διὰ τοῦτο ἔδωκα αὐτοῖς θηλείας, ἵνα σπερματίζουσιν εἰς αὐτὰς καὶ τεκνώσουσιν ἐν αὐταῖς τέκνα οὕτως, ἵνα μὴ ἐκλείπῃ αὐτοῖς πᾶν ἔργον ἐπὶ τῆς γῆς."
										},
										"_id": "1952",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὑμεῖς δὲ ὑπήρχετε πνεύματα ζῶντα αἰώνια καὶ οὐκ ἀποθνήσκοντα εἰς πάσας τὰς γενεὰς τοῦ αἰῶνος."
										},
										"_id": "1953",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ διὰ τοῦτο οὐκ ἐποίησα ἐν ὑμῖν θηλείας· τὰ πνεύματα τοῦ οὐρανοῦ, ἐν τῷ οὐρανῷ ἡ κατοίκησις αὐτῶν."
										},
										"_id": "1954",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ νῦν οἱ γίγαντες οἱ γεννηθέντες ἀπὸ τῶν πνευμάτων καὶ σαρκὸς πνεύματα ἰσχυρὰ ἐπὶ τῆς γῆς, καὶ ἐν τῇ γῇ ἡ κατοίκησις αὐτῶν ἔσται."
										},
										"_id": "1955",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πνεύματα πονηρὰ ἐξῆλθον ἀπὸ τοῦ σώματος αὐτῶν, διότι ἀπὸ τῶν ἀνωτέρων ἐγένοντο, καὶ ἐκ τῶν ἁγίων ἐγρηγόρων ἡ ἀρχὴ τῆς κτίσεως αὐτῶν καὶ ἀρχὴ θεμελίου· πνεύματα πονηρὰ κληθήσεται."
										},
										"_id": "1956",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πνεύματα οὐρανοῦ, ἐν τῷ οὐρανῷ ἡ κατοίκησις αὐτῶν ἔσται καὶ τὰ πνεύματα ἐπὶ τῆς γῆς τὰ γεννηθέντα, ἐπὶ τῆς γῆς ἡ κατοίκησις αὐτῶν ἔσται."
										},
										"_id": "1957",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὰ πνεύματα τῶν γιγάντων νεφέλας ἀδικοῦντα, ἀφανίζοντα καὶ ἐνπίπτοντα καὶ συνπαλαίοντα καὶ συνρίπτοντα ἐπὶ τῆς γῆς, πνεύματα σκληρὰ γιγάντων, καὶ δρόμους ποιοῦντα καὶ μηδὲν ἐσθίοντα, ἀλλ᾽ ἀσιτοῦντα καὶ διψῶντα καὶ προσκόπτοντα πνεύματα."
										},
										"_id": "1958",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐξαναστήσει ταῦτα εἰς τοὺς υἱοὺς τῶν ἀνθρώπων καὶ τῶν γυναικῶν, ὅτι ἐξεληλύθασιν ἀπ᾽ αὐτῶν,"
										},
										"_id": "1959",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								}
							],
							"_number": "15"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἀπὸ ἡμέρας σφαγῆς καὶ ἀπωλείας καὶ θανάτου, ἀφ᾽ ὧν τὰ πνεύματα ἐκπορευόμενα ἐκ τῆς ψυχῆς τῆς σαρκὸς αὐτῶν ἔσται ἀφανίζοντα χωρὶς κρίσεως· οὕτως ἀφανίσουσιν μέχρις ἡμέρας τελειώσεως, τῆς κρίσεως τῆς μεγάλης, ἐν ᾗ ὁ αἰὼν ὁ μέγας τελεσθήσεται."
										},
										"_id": "1960",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ νῦν ἐγρηγόροις τοῖς πέμψασίν σε ἐρωτῆσαι περὶ αὐτῶν, οἵτινες ἐν οὐρανῷ ἦσαν."
										},
										"_id": "1961",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὑμεῖς ἐν τῷ οὐρανῷ ἦτε, καὶ πᾶν μυστήριον ὃ οὐκ ἀνεκαλύφθη ὑμῖν καὶ μυστήριον τὸ ἐκ τοῦ θεοῦ γεγενημένον ἔγνωτε, καὶ τοῦτο ἐμηνύσατε ταῖς γυναιξὶν ἐν ταῖς σκληροκαρδίαις ὑμῶν, καὶ ἐν τῷ μυστηρίῳ τούτῳ πληθύνουσιν αἱ θήλειαι καὶ οἱ ἄνθρωποι τὰ κακὰ ἐπὶ τῆς γῆς."
										},
										"_id": "1962",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "εἶπον οὖν αὐτοῖς· Οὐκ ἔστιν εἰρήνη."
										},
										"_id": "1963",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								}
							],
							"_number": "16"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ παραλαβόντες με εἴς τινα τόπον ἀπήγαγον, ἐν ᾧ οἱ ὄντες ἐκεῖ γίνονται ὡς πῦρ φλέγον καὶ ὅταν θέλωσιν, φαίνονται ὡσεὶ ἄνθρωποι."
										},
										"_id": "1964",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπήγαγόν με εἰς γνοφώδη τόπον καὶ εἰς ὄρος οὗ ἡ κεφαλὴ ἀφικνεῖτο εἰς τὸν οὐρανόν."
										},
										"_id": "1965",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶδον τόπον τῶν φωστήρων καὶ τοὺς θησαυροὺς τῶν ἀστέρων καὶ τῶν βροντῶν, καὶ εἰς τὰ ἀεροβαθῆ, ὅπου τόξον πυρὸς καὶ τὰ βέλη καὶ τὰς θήκας αὐτῶν καὶ τὰς ἀστραπὰς πάσας."
										},
										"_id": "1966",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπήγαγόν με μέχρι ὑδάτων καὶ μέχρι πυρὸς δύσεως, ὅ ἐστιν καὶ παρέχον πάσας τὰς δύσεις τοῦ ἡλίου."
										},
										"_id": "1967",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἤλθομεν μέχρι ποταμοῦ πυρός, ἐν ᾧ κατατρέχει τὸ πῦρ ὡς ὕδωρ καὶ ῥέει εἰς θάλασσαν μεγάλην δύσεως."
										},
										"_id": "1968",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον τοὺς μεγάλους ποταμούς, καὶ μέχρι τοῦ μεγάλου ποταμοῦ καὶ μέχρι τοῦ μεγάλου σκότους κατήντησα, καὶ ἀπῆλθον ὅπου πᾶσα σὰρξ περιπατεῖ."
										},
										"_id": "1969",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον τοὺς ἀνέμους τῶν γνόφων τοὺς χειμερινοὺς καὶ τὴν ἔκχυσιν τῆς ἀβύσσου πάντων ὑδάτων."
										},
										"_id": "1970",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον τὸ στόμα τῆς γῆς πάντων τῶν ποταμῶν καὶ τὸ στόμα τῆς ἀβύσσου."
										},
										"_id": "1971",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								}
							],
							"_number": "17"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον τοὺς θησαυροὺς τῶν ἀνέμων πάντων, ἴδον ὅτι ἐν αὐτοῖς ἐκόσμησεν πάσας τὰς κτίσεις καὶ τὸν θεμέλιον τῆς γῆς, καὶ τὸν λίθον ἴδον τῆς γωνίας τῆς γῆς."
										},
										"_id": "1972",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον τοὺς τέσσαρας ἀνέμους τὴν γῆν βαστάζοντας,"
										},
										"_id": "1973",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὸ στερέωμα τοῦ οὐρανοῦ, καὶ αὐτοὶ ἱστᾶσιν μεταξὺ γῆς καὶ οὐρανοῦ."
										},
										"_id": "1974",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἴδον ἀνέμους τῶν οὐρανῶν στρέφοντας καὶ διανεύοντας τὸν τροχὸν τοῦ ἡλίου, καὶ πάντας τοὺς ἀστέρας. 5 ἴδον τοὺς ἐπὶ τῆς γῆς ἀνέμους βαστάζοντας ἐν νεφέλῃ. ἴδον πέρατα τῆς γῆς, τὸ στήριγμα τοῦ οὐρανοῦ ἐπάνω."
										},
										"_id": "1975",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "παρῆλθον καὶ ἴδον τόπον καιόμενον νυκτὸς καὶ ἡμέρας, ὅπου τὰ ἑπτὰ ὄρη ἀπὸ λίθων πολυτελῶν, [τρία] εἰς ἀνατολὰς καὶ τρία εἰς νότον βάλλοντα."
										},
										"_id": "1976",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὰ μὲν πρὸς ἀνατολὰς ἀπὸ λίθου χρώματος, τὸ δὲ ἦν ἀπὸ λίθου μαργαρίτου, καὶ τὸ ἀπὸ λίθου ταθέν, τὸ δὲ κατὰ νότον ἀπὸ λίθου πυρροῦ·"
										},
										"_id": "1977",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τὸ δὲ μέσον αὐτῶν ἦν εἰς οὐρανόν, ὥσπερ θρόνος θεοῦ ἀπὸ λίθου φουκά, καὶ ἡ κορυφὴ τοῦ θρόνου ἀπὸ λίθου σαφφείρου·"
										},
										"_id": "1978",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πῦρ καιόμενον ἴδον. κἀπέκεινα τῶν ὀρέων τούτων"
										},
										"_id": "1979",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τόπος ἐστὶν πέρας τῆς μεγάλης γῆς· ἐκεῖ συντελεσθήσονται οἱ οὐρανοί."
										},
										"_id": "1980",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἴδον χάσμα μέγα εἰς τοὺς στύλους τοῦ πυρὸς καταβαίνοντας καὶ οὐκ ἦν μέτρον οὔτε εἰς βάθος οὔτε εἰς ὕψος."
										},
										"_id": "1981",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐπέκεινα τοῦ χάσματος τούτου ἴδον τόπον ὅπου οὐδὲ στερέωμα οὐρανοῦ ἐπάνω, οὔτε γῆ ᾖ τεθεμελιωμένη ὑποκάτω αὐτοῦ, οὔτε ὕδωρ ἦν ὑπὸ αὐτὸ οὔτε πετεινόν, ἀλλὰ τόπος ἦν ἔρημος καὶ φοβερός."
										},
										"_id": "1982",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐκεῖ ἴδον ἑπτὰ ἀστέρας ὡς ὄρη μεγάλα καιόμενα, περὶ ὧν πυνθανομένῳ μοι"
										},
										"_id": "1983",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "εἶπεν ὁ ἄγγελος Οὗτός ἐστιν ὁ τόπος τὸ τέλος τοῦ οὐρανοῦ καὶ γῆς· δεσμωτήριον τοῦτο ἐγένετο τοῖς ἄστροις καὶ ταῖς δυνάμεσιν τοῦ οὐρανοῦ."
										},
										"_id": "1984",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οἱ ἀστέρες οἱ κυλιόμενοι ἐν τῷ πυρί, οὗτοί εἰσιν οἱ παραβάντες πρόσταγμα κυρίου ἐν ἀρχῇ τῆς ἀνατολῆς αὐτῶν—ὅτι τόπος ἔξω τοῦ οὐρανοῦ κενός ἐστιν—ὅτι οὐκ ἐξῆλθαν ἐν τοῖς καιροῖς αὐτῶν."
										},
										"_id": "1985",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ὀργίσθη αὐτοῖς καὶ ἔδησεν αὐτοὺς μέχρι καιροῦ τελειώσεως αὐτῶν ἁμαρτίας αὐτῶν, ἐνιαυτῶν μυρίων."
										},
										"_id": "1986",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								}
							],
							"_number": "18"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ εἶπέν μοι Οὐριὴλ Ἐνθάδε οἱ μιγέντες ἄγγελοι ταῖς γυναιξὶν στήσονται, καὶ τὰ πνεύματα αὐτῶν πολύμορφα γενόμενα λυμαίνεται τοὺς ἀνθρώπους καὶ πλανήσει αὐτοὺς ἐπιθύειν τοῖς δαιμονίοις μέχρι τῆς μεγάλης κρίσεως, ἐν ᾗ κριθήσονται εἰς ἀποτελείωσιν."
										},
										"_id": "1987",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ αἱ γυναῖκες αὐτῶν τῶν παραβάντων ἀγγέλων εἰς σειρῆνας γενήσονται."
										},
										"_id": "1988",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "κἀγὼ Ἑνὼχ ἴδον τὰ θεωρήματα μόνος, τὰ πέρατα πάντων, καὶ οὐ μὴ ἴδῃ οὐδὲ εἷς"
											},
											"_id": "1989",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ἀνθρώπων ὡς ἐγὼ"
											},
											"_id": "1990",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἴδον."
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "εἶδον."
												}
											],
											"_id": "1991",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								}
							],
							"_number": "19"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ἄγγελοι τῶν δυνάμεων."
										},
										"_id": "1992",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "Οὐριήλ,"
											},
											"_id": "1993",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ὁ εἷς τῶν ἁγίων"
											},
											"_id": "1994",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἀγγέλων"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 "
												}
											],
											"_id": "1995",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ἀγγέλων ὁ ἐπὶ τοῦ κόσμου καὶ τοῦ ταρτάρου."
											},
											"_id": "1996",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh Gizeh2 ",
											"__text": "Ῥαφαήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὁ ἐπὶ τῶν πνευμάτων τῶν ἀνθρώπων,"
										},
										"_id": "1997",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh Gizeh2 ",
											"__text": "Ῥαγουήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὁ ἐκδικῶν τὸν κόσμον τῶν φωστήρων."
										},
										"_id": "1998",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "Μιχαήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων"
											},
											"_id": "1999",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὁ"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "ὃς"
												}
											],
											"_id": "2000",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ἐπὶ τῶν τοῦ λαοῦ ἀγαθῶν"
											},
											"_id": "2001",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "τεταγμένος"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "τέτακται"
												}
											],
											"_id": "2002",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "καὶ ἐπὶ τῷ χάῳ."
											},
											"_id": "2003",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh Gizeh2 ",
											"__text": "Σαριήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὁ ἐπὶ τῶν πνευμάτων οἵτινες ἐπὶ τῷ πνεύματι ἁμαρτάνουσιν."
										},
										"_id": "2004",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "Γαβριήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὁ ἐπὶ τοῦ παραδείσου καὶ τῶν δρακόντων καὶ"
											},
											"_id": "2005",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "χερουβείν,"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "χερουβίν,"
												}
											],
											"_id": "2006",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "Ῥεμειήλ, ὁ εἷς τῶν ἁγίων ἀγγέλλων ὃν ἔταξεν ὁ θεὸς ἐπὶ τῶν ἀνισταμένων."
												}
											],
											"_id": "2007",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἀρχαγγέλων ὀνόματα ἑπτά."
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "ὀνόματα ζʹ ἀρχαγγέλων."
												}
											],
											"_id": "2008",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "7"
								}
							],
							"_number": "20"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "Καὶ ἐφώδευσα"
											},
											"_id": "2009",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἕως"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "μέχρι"
												}
											],
											"_id": "2010",
