									"_number": "3"
								}
							],
							"_number": "87"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "Καὶ οἱ κύνες ἤρξαντο κατεσθίειν τὰ πρόβατα καὶ οἱ ὕες καὶ οἱ ἀλώπεκες κατήσθιον αὐτὰ, μέχρι οὗ ἤγειρεν ὁ κύριος τῶν προβάτων κριὸν ἕνα ἐκ τῶν προβάτων."
										},
										"_id": "2123",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "42"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ ὁ κριὸς οὗτος ἤρξατο κερατίζειν καὶ ἐπιδιώκειν ἐν τοῖς κέρασιν, καὶ ἐνετίνασσεν εἰς τοὺς ἀλώπεκας, καὶ μετ᾽ αὐτοὺς εἰς τοὺς ὕας· καὶ ἀπώλεσεν ὕας πολλούς, καὶ μετ᾽ αὐτοὺς [...]το τοὺς κύνας."
										},
										"_id": "2124",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "43"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ τὰ πρόβατα ὧν οἱ ὀφθαλμοὶ ἠνοίγησαν ἐθεάσαντο τὸν κριὸν τὸν ἐν τοῖς προβάτοις, ἕως οὗ ἀφῆκεν τὴν ὁδὸν αὐτοῦ καὶ ἤρξατο πορεύεσθαι ἀνοδίᾳ."
										},
										"_id": "2125",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "44"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ ὁ κύριος τῶν προβάτων ἀπέστειλεν τὸν ἄρνα τοῦτον ἐπὶ ἄρνα ἕτερον, τοῦ στῆσαι αὐτὸν εἰς κριὸν ἐν ἀρχῇ τῶν προβάτων ἀντὶ τοῦ κριοῦ τοῦ ἀφέντος τὴν ὁδὸν αὐτοῦ."
										},
										"_id": "2126",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "45"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ ἐπορεύθη πρὸς αὐτὸν καὶ ἐλάλησεν αὐτῷ σιγῇ κατὰ μόνας, καὶ ἤγειρεν αὐτὸν εἰς κριὸν καὶ εἰς ἄρχοντα καὶ εἰς ἡγούμενον τῶν προβάτων· καὶ οἱ κύνες ἐπὶ πᾶσιν τούτοις ἔθλιβον τὰ πρόβατα."
										},
										"_id": "2127",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "46"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "[καὶ] ὁ κριὸς ὁ πρῶτος τὸν κριὸν τὸν δεύτερον ἐπεδίωκεν, καὶ ἔφυγεν ἀπὸ προσώπου αὐτοῦ· εἶτ᾽ ἐθεώρουν τὸν κριὸν τὸν πρῶτον ἕως οὗ ἔπεσεν ἔμπροσθεν τῶν κυνῶν."
										},
										"_id": "2128",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "47"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ ὁ κριὸς ὁ δεύτερος ἀναπηδήσας ἀφηγήσατο τῶν προβάτων."
										},
										"_id": "2129",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "48"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "V1809 ",
											"__text": "καὶ τὰ πρόβατα ηὐξήθησαν καὶ ἐπληθύνθησαν· καὶ πάντες οἱ κύνες καὶ οἱ ἀλώπεκες ἔφυγον ἀπ᾽ αὐτοῦ καὶ ἐφοβοῦντο αὐτόν . . ."
										},
										"_id": "2130",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "49"
								}
							],
							"_number": "89"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Syncellus ",
												"__text": ". . ."
											},
											"_id": "2131",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "παρὰ"
												},
												{
													"_option": "1",
													"_mss": "Goar ",
													"__text": "περὶ"
												}
											],
											"_id": "2132",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Syncellus ",
												"__text": "δὲ τοῦ ὄρους ἐν ᾧ ὤμοσαν καὶ ἀνεθεμάτισαν πρὸς τὸν πλησίον αὐτῶν, ὅτι εἰς τὸν αἰῶνα οὐ μὴ ἀποστῇ ἀπ᾽ αὐτοῦ ψῦχος καὶ χιὼν καὶ πάχνη, καὶ δρόσος οὐ μὴ καταβῇ εἰς αὐτό, εἰ μὴ εἰς κατάραν καταβήσεται"
											},
											"_id": "2133",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "ἐπ᾽"
												},
												{
													"_option": "1",
													"_mss": "Goar ",
													"__text": "εἰς"
												}
											],
											"_id": "2134",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Syncellus ",
												"__text": "αὐτό, μέχρις ἡμέρας κρίσεως τῆς μεγάλης."
											},
											"_id": "2135",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Syncellus ",
												"__text": "ἐν τῷ καιρῷ ἐκείνῳ κατακαυθήσεται"
											},
											"_id": "2136",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Syncellus ",
													"__text": "καὶ"
												},
												{
													"_option": "1",
													"_mss": "Goar "
												}
											],
											"_id": "2137",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Syncellus ",
												"__text": "ταπεινωθήσεται, καὶ ἔσται κατακαιόμενον καὶ τηκόμενον ὡς κηρὸς ἀπὸ πυρός, οὕτως κατακήσεται περὶ πάντων τῶν ἔργων αὐτοῦ"
											},
											"_id": "2138",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Syncellus ",
											"__text": "καὶ νῦν ἐγὼ λέγω ὑμῖν υἱοῖς ἀνθρώπων Ὀργὴ μεγάλη καθ᾽ ὑμῶν, κατὰ τῶν υἱῶν ὑμῶν· καὶ οὐ παύσεται ἡ ὀργὴ αὕτη ἀφ᾽ ὑμῶν μέχρι καιροῦ σφαγῆς τῶν υἱῶν ὑμῶν."
										},
										"_id": "2139",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Syncellus ",
											"__text": "καὶ ἀπολοῦνται οἱ ἀγαπητοὶ ὑμῶν καὶ ἀποθανοῦνται οἱ ἔντιμοι ὑμῶν ἀπὸ πάσης τῆς γῆς, ὅτι πᾶσαι αἱ ἡμέραι τῆς ζωῆς αὐτῶν ἀπὸ τοῦ νῦν οὐ μὴ ἔσονται πλείω τῶν ἑκατὸν εἴκοσιν ἐτῶν."
										},
										"_id": "2140",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Syncellus ",
											"__text": "καὶ μὴ δόξητε ἔτι ζῆσαι ἐπὶ πλείονα ἔτη· οὐ γάρ ἐστιν ἐπ᾽ αὐτοῖς πᾶσα ὁδὸς ἐκφεύξεως ἀπὸ τοῦ νῦν, διὰ τὴν ὀργὴν ἣν ὠργίσθη ὑμῖν ὁ βασιλεὺς πάντων τῶν αἰώνων· μὴ νομίσητε ὅτι ἐκφεύξεσθε ταῦτα."
										},
										"_id": "2141",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": ". . . [καὶ ἀναγνωσθήσ]ονται [πάντες] οἱ λόγοι τῶν ἀνομιῶν ὑμῶν ἐν[ώπιον] τοῦ μεγάλου ἁγίου κατὰ πρόσωπον ὑμῶν·"
											},
											"_id": "2142",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "ειτανεφελει"
												},
												{
													"_option": "1",
													"_mss": "Bonner Black ",
													"__text": "εἶτ᾽ ἀναφελεῖ"
												}
											],
											"_id": "2143",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "τὰ πάντα ἔργα τὰ μετασχόντα ἐν τῇ ἀνομίᾳ."
											},
											"_id": "2144",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ ἁμαρτωλοὶ [οἱ] ἐν μέσῳ τῆς θαλάσσης καὶ ἐπὶ τῆς ξηρᾶς ὄντες· μνημόσυνον εἰς ὑμᾶς κακόν."
										},
										"_id": "2145",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ κτώμενοι χρυσίον καὶ ἀργύριον οὐκ ἀπὸ δικαιοσύνης, καὶ ἐρεῖτε, πλούτῳ πεπλουτήκαμεν καὶ τὰ ὑπάρχοντα ἐσχήκαμεν καὶ κεκτήμεθα,"
										},
										"_id": "2146",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ πᾶν ὃ ἐὰν θελήσωμεν ποιήσωμεν, ὅτι ἀργύριον τεθησαυρίκαμεν ἐν τοῖς θησαυροῖς ἡμῶν καὶ ἀγαθὰ πολλὰ ἐν ταῖς οἰκίαις ἡμῶν."
										},
										"_id": "2147",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ ὡς ὕδωρ"
											},
											"_id": "2148",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "εκσχισστε"
												},
												{
													"_option": "1",
													"_mss": "Bonner Kenyon ",
													"__text": "ἐκκέχυται"
												},
												{
													"_option": "2",
													"_mss": "Black ",
													"__text": "ἐκχυθήσεται"
												}
											],
											"_id": "2149",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "πεπλάνησθε, ὅτι οὐ μὴ παραμείνῃ ὁ πλοῦτος ὑμῶν, ἀλλὰ ταχὺ"
											},
											"_id": "2150",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 "
												},
												{
													"_option": "1",
													"_mss": "Kenyon Black ",
													"__text": "[ἀναπτήσεται]"
												},
												{
													"_option": "2",
													"_mss": "Bonner ",
													"__text": "[ἀπελεύσεται]"
												}
											],
											"_id": "2151",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἀπὸ ὑμῶν, ὅτι ἀδίκως πάντα κέκτησθε· καὶ ὑμεῖς εἰς κατάραν μεγάλην παραδοθήσεσθε."
											},
											"_id": "2152",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "10"
								}
							],
							"_number": "97"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "Καὶ νῦν ὀμνύω ὑμῖν τοῖς φρονίμοις καὶ"
											},
											"_id": "2153",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "οὐχὶ"
												},
												{
													"_option": "1",
													"_mss": "Ε "
												}
											],
											"_id": "2154",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "τοῖς ἄφροσι, ὅτι πολλὰς ὄψεσθε ἐπὶ τῆς γῆς ἀνομίας·"
											},
											"_id": "2155",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὅτι κάλλος περιθήσονται ἄνδρες ὡς γυναῖκες, [καὶ] χρῶμα ὡραῖον ὑπὲρ παρθένους, ἐν βασιλείᾳ καὶ μεγαλωσύνῃ καὶ ἐν ἐξουσίᾳ. ἔσονται δὲ ἀργύριον καὶ χρυσίον [παρ᾽] αὐτοῖς εἰς βρώματα, καὶ ἐν ταῖς οἰκίαις αὐτῶν ὡς ὕδωρ ἐκχυθήσονται"
										},
										"_id": "2156",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "[...]"
												},
												{
													"_option": "1",
													"_mss": "Bonner Black ",
													"__text": "[διὰ τὸ μ]ὴ"
												},
												{
													"_option": "2",
													"_mss": "Kenyon ",
													"__text": "[οὐ μὴ δῶ]"
												}
											],
											"_id": "2157",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἐπιστήμην αὐτοὺς"
											},
											"_id": "2158",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 Bonner Black ",
													"__text": "μηδὲ φρόνησιν μηδεμίαν"
												},
												{
													"_option": "1",
													"_mss": "Kenyon ",
													"__text": "φρόν[ησιν μηδ]εμίαν"
												}
											],
											"_id": "2159",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 Bonner ",
												"__text": "[ἔχειν]. οὕτω ἀπολεῖσθε κοινῶς μετὰ πάντων [τῶν] ὑπαρχόντων ὑμῶν [καὶ τῆς] πάσης δόξης καὶ τῆς τιμῆς [ὑμῶν καὶ] εἰς ἀτιμίαν καὶ ἐρήμωσιν [καὶ σφαγὴν] μεγάλην τ[ὰ πνεύματα ὑμῶν εἰς τὴν κάμινον τοῦ πυρὸς ἐμβληθήσεται.]"
											},
											"_id": "2160",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . ἐπὶ τὴν [γῆν οὐκ ἀπεστάλη ἀλλ᾽ αὐτὴν οἱ ἄνθρω]ποι ἀφ᾽ ἑαυτῶν [ἔκτισαν καὶ εἰς κατάραν] μεγάλην ἀφίξονται οἱ ποιοῦντες [αὐτήν]."
										},
										"_id": "2161",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ"
											},
											"_id": "2162",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 Bonner ",
													"__text": "δουλεία γυναικὶ οὐκ ἐδόθη"
												},
												{
													"_option": "1",
													"_mss": "Kenyon ",
													"__text": "στείρᾳ γυναικί"
												}
											],
											"_id": "2163",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 Bonner "
												},
												{
													"_option": "1",
													"_mss": "Kenyon ",
													"__text": "ἀτεκνία"
												}
											],
											"_id": "2164",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἀλλὰ διὰ τὰ ἔργα τῶν χειρῶν· ὅτι οὐχ ὡρίσθη δούλην εἶναι δούλην· ἄνωθεν οὐκ ἐδόθη ἀλλὰ ἐκ καταδυναστείας ἐγένετο. ὁ[μοίως] οὐδὲ ἡ ἀνομία ἄνωθεν ἐδόθη ἀλλ᾽ ἐκ παραβάσεως. ὁμοίως οὐδὲ στεῖρα γυνὴ ἐκτίσθη ἀλλ᾽ ἐξ ἰδίων ἀδικημάτων ἐπετιμήθη ἀτεκνίᾳ [καὶ] ἄτεκνος ἀποθανεῖται."
											},
											"_id": "2165",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὀμνύω ὑμῖν ἁμαρτωλοὶ κατὰ τοῦ ἁγίου τοῦ μεγάλου ὅτι τὰ ἔργα ὑμῶν τὰ πονηρὰ ἔσται ἀνακεκαλυμμένα ἐν τῷ οὐρανῷ· οὐκ ἔσται ὑμῖν ἔργον ἀποκεκρυμμένον ἄδικον."
										},
										"_id": "2166",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μὴ ὑπολάβητε τῇ ψυχῇ ὑμῶν μηδὲ ὑπολάβητε τῇ καρδίᾳ ὑμῶν ὅτι οὐ γινώσκουσιν οὐδὲ βλέπουσιν οὐδὲ τὰ ἀδικήματα ὑμῶν θεωρεῖτε, οὐδὲ ἀπογράφεται αὐτὰ ἐνώπιον τοῦ ὑψίστου."
										},
										"_id": "2167",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἀπὸ τοῦ [νῦν] ἐπιγνῶτε ὅτι πάντα τὰ ἀδικήματα ὑμῶν ἀπογράφονται ἡμέραν ἐξ [ἡμέρας] μέχρι τῆς κρίσεως ὑμῶν."
										},
										"_id": "2168",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 Bonner ",
												"__text": "οὐαὶ ὑμῖν ἄφρονες ὅτι ἀπολεῖσθε διὰ τὴν ἀφροσύνην ὑμῶν καὶ τῶν [φρονίμων] οὐ μὴ ἀκούσητε καὶ τὰ ἀγαθὰ οὐκ ἀπαντήσει ὑμῖν, τὰ δὲ κακὰ"
											},
											"_id": "2169",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "[...]"
												},
												{
													"_option": "1",
													"_mss": "Bonner Black ",
													"__text": "[περιέξει]"
												},
												{
													"_option": "2",
													"_mss": "Kenyon ",
													"__text": "[καθέξει]"
												}
											],
											"_id": "2170",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 Bonner ",
												"__text": "ὑμᾶς."
											},
											"_id": "2171",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ νῦν γινώσκετε ὅτ[ι ἡτοίμασται] ὑμῖν εἰς ἡμέραν ἀπωλείας. [μὴ ἐλπίζε]τε σωθῆναι, ἁμαρτωλοί· ἀπ[ελθόντες] ἀποθάνετε, γινώσκοντε[ς ὅτι ἡτοίμασ]ται εἰς ἡμέραν κρίσεως μ[εγάλης καὶ στε]νοχωρίας μείζονος τ[οῖς πνεύμασιν ὑμῶν.]"
										},
										"_id": "2172",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ σκληροτράχηλοι τῇ καρδίᾳ ποιοῦντες τὸ κἄκὸν καὶ ἔσθοντες αἷμα πόθ]εν ὑμῖν ἔσο[νται ἀγαθὰ ἵνα φάγητε . . ."
										},
										"_id": "2173",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . ἔργα τῆ]ς ἀδικίας· διότι ἐλπίδας κα[λὰς ἔχετε ὑμῖ]ν; νῦν γνωστὸν ὑμῖν ἔστω ὅτι εἰς [χεῖρας τ]ῶν δικαίων παραδοθήσεσθε καὶ ἀποκτενοῦσιν ὑμᾶς καὶ οὐ μὴ φείσονται ὑμῶν."
										},
										"_id": "2174",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "οὐαὶ ὑμῖν οἱ ἐπιχαίροντες τοῖς κακοῖς τῶν δικαίων·"
											},
											"_id": "2175",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "τογος"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "τάφος"
												}
											],
											"_id": "2176",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ὑμῶν οὐ μὴ ὀρυγῇ."
											},
											"_id": "2177",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν βουλόμενοι ἀκυρῶσαι τοὺς λόγους τῶν δικαίων· οὐ μὴ γένηται ὑμῖν ἐλπὶς σωτηρίας."
										},
										"_id": "2178",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ γράφοντες λόγους ψευδεῖς καὶ λόγους πλανήσεως· αὐτοὶ γράφουσιν καὶ πολλοὺς ἀποπλανήσουσιν τοῖς ψεύδεσιν αὐτῶν·"
										},
										"_id": "2179",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "πλανᾶσθε ὑμεῖς αὐτοὶ καὶ οὐκ ἔστιν ὑμῖν χαίρειν, ἀλλὰ ταχέως ἀπολεῖσθε."
										},
										"_id": "2180",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								}
							],
							"_number": "98"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "Οὐαὶ ὑμῖν οἱ ποιοῦντες πλανήματα, καὶ τοῖς ἔργοις τοῖς ψεύδεσιν λαμβάνοντες τιμὴν καὶ δόξαν· ἀπολώλατε, οὐκ ἔστιν ὑμῖν σωτηρία εἰς ἀγαθόν."
										},
										"_id": "2181",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ ἐξαλλοιοῦντες τοὺς λόγους τοὺς ἀληθινούς, καὶ διαστρέφοντες τὴν αἰώνιον διαθήκην, καὶ λογιζόμενοι ἑαυτοὺς ἀναμαρτήτους· ἐν τῇ γῇ καταποθήσονται."
										},
										"_id": "2182",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "τότε ἑτοιμάζεσθε οἱ δίκαιοι καὶ προέχεσθε τὰς ἐντεύξεις ὑμῶν εἰς μνημόσυνον, δίδοτε αὐτὰς ἐν διαμαρτυρίᾳ ἐνώπιον τῶν ἀγγέλων, ὅπως εἰσαγάγωσιν τὰ ἁμαρτήματα τῶν ἀδίκων ἐνώπιον τοῦ ὑψίστου θεοῦ εἰς  μνημόσυνον·"
										},
										"_id": "2183",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ τότε συν[ταραχ]θήσονται ἐν [ἡμέρ]ᾳ ἀπωλείας τῆς ἀδικίας."
										},
										"_id": "2184",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἐν αὐτῷ [τῷ και]ρῷ ἐκείνῳ αἱ τίκτουσαι ἐκβαλοῦσιν καὶ"
											},
											"_id": "2185",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "ἐκπάσουσιν"
												},
												{
													"_option": "1",
													"_mss": "Kenyon Black ",
													"__text": "ἐκσπάσουσιν"
												},
												{
													"_option": "2",
													"_mss": "Bonner ",
													"__text": "ἐκποιήσουσιν"
												}
											],
											"_id": "2186",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ ἐγκαταλείψουσιν [τὸ νήπιο]ν βρέφος, καὶ αἱ ἐν γαστρὶ ἔχου[σαι ἐκτρώσο]υσιν καὶ αἱ θηλάζουσαι ῥίψ[ουσιν τὰ τέκ]να αὐτῶν καὶ οὐ μὴ ἐπι[στρέψου]σιν ἐπὶ τὰ νήπια αὐτῶν οὐ[δὲ ἐπὶ τὰ θηλά]ζοντα οὐδὲ μὴ φείσονται . . ."
											},
											"_id": "2187",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": {
										"reading": [
											{
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "[...] οἱ γλύφοντες εἰκόνα[...]ρᾶς καὶ χρυσᾶς, ξυλίνας τε [καὶ λιθίνας] καὶ ὀστρακίνας, καὶ λατρεύ[...]τάσμασιν καὶ δαιμονίοι[...]μασιν καὶ πνεύμασιν πονη[...] πάσαις ταῖς πλάναις οὐ κατ᾽ ἐπι[...] καὶ πᾶν βοήθημα οὐ μὴ εὕρηται [...] αὐτῶν."
											},
											{
												"_option": "1",
												"_mss": "Black ",
												"__text": "[καὶ] οἱ γλύφοντες εἰκόνα[ς ἀργυ]ρᾶς καὶ χρυσᾶς, ξυλίνας τε [καὶ λιθίνας] καὶ ὀστρακίνας, καὶ λατρεύ[οντες φαν]τάσμασιν καὶ δαιμονίοι[ς καὶ βδελύγ]μασιν καὶ πνεύμασιν πονη[ροῖς καὶ] πάσαις ταῖς πλάναις οὐ κατ᾽ ἐπι[στήμην] καὶ πᾶν βοήθημα οὐ μὴ εὕρητε [ἀπ᾽] αὐτῶν."
											}
										],
										"_id": "2188",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ πλανηθήσονται ἐν ἀφροσύνῃ τῆς καρδίας αὐτῶν καὶ τὰ ὁράματα τῶν ἐνυπνίων καταπλανήσουσιν ὑμᾶς,"
										},
										"_id": "2189",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὑμεῖς καὶ τὰ ἔργα ὑμῶν τὰ ψευδῆ ἃ ἐποιήσατε καὶ ἐλαεργ[ήσατε], καὶ ἐπὶ μιᾶς ἀπολεῖσθε."
										},
										"_id": "2190",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ τότε μακάριοι πάντες οἱ ἀκούσαντες φρονίμων λόγους καὶ μαθήσονται αὐτούς, ποιῆσαι τὰς ἐντολὰς τοῦ ὑψίστου, καὶ πορεύσονται ἐν ὁδοῖς δικαιοσύνης αὐτοῦ καὶ οὐ μὴ πλανήσουσιν μετὰ τῶν πλανώντων καὶ σωθήσονται. . . ."
										},
										"_id": "2191",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "οὐαὶ οἱ οἰκοδομοῦντες τὰς οἰκοδομὰς αὐτῶν οὐκ ἐκ κόπων ἰδίων, καὶ ἐκ λίθων καὶ ἐκ πλίνθων πᾶσαν οἰκοδομὴν ποιεῖτε"
											},
											"_id": "2192",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 Black ",
													"__text": "οἷς οὐκ ἔστιν ὑμῖν χά[ρις]."
												},
												{
													"_option": "1",
													"_mss": "Bonner ",
													"__text": "ματαίοι οὐκ ἔστιν ὑμῖν χα[ίρειν]."
												}
											],
											"_id": "2193",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ οἱ ἐξουθενοῦντες τὴν θεμελίωσιν καὶ τὴν κληρονομίαν τῶν πατέρων αὐτῶν τὴν ἀπ᾽ αἰῶνος, [ὅτι] διώξεται ὑμᾶς πνεῦμα πλανήσεως· οὐκ ἔστιν ὑμῖν ἀναπαῦσαι."
										},
										"_id": "2194",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ ποιοῦντες τὴν ἀ[νομίαν] καὶ ἐπιβοηθοῦντες τῇ ἀδι[κίᾳ, φονεύ]οντες τὸν πλησίον αὐτῶ[ν ἕως τῆς] ἡμέρας τῆς κρίσεως τῆς [μεγάλης·]"
										},
										"_id": "2195",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὅτι τότε ἐκτρίψει τὴν δόξ[αν ὑμῶν] καὶ ἐπεγερεῖ τὸν θυμὸν [αὐτοῦ καθ᾽] ὑμῶν ἀπολεῖ πάντας ὑ[μᾶς ἐν ῥομ]φαίᾳ καὶ πάντες οἱ δί[καιοι μνημο]νήσουσιν τὰς ἀδικίας [ὑμῶν]."
										},
										"_id": "2196",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								}
							],
							"_number": "99"
						},
						{
							"div": [
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": ". . . καὶ τότε ἐν ἑνὶ τόπῳ . . ."
											},
											"_id": "2197",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "[...]ιμα[...."
												},
												{
													"_option": "1",
													"_mss": "Bonner ",
													"__text": "[ἕως ὡς ποταμὸς ῥέῃ τοῦ α]ἵμα[τος αὐτῶν."
												},
												{
													"_option": "2",
													"_mss": "Black ",
													"__text": "[ῥέῃ τὰ α]ἵμα[τα αὐτῶν."
												}
											],
											"_id": "2198",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἄνθρωπο]ς οὐκ [ἀφέξ]ει τὴν [χεῖρα αὐτοῦ ἀπ]ὸ τοῦ υἱοῦ αὐ[τοῦ, οὔτ᾽ ἀ]πὸ τοῦ ἀγαπητοῦ αὐτοῦ ἀποκτεῖναι αὐτόν, καὶ ὁ ἁμαρτωλὸς ἀπὸ τοῦ ἐντίμου, οὔτε ἀπὸ τοῦ ἀδελφοῦ αὐτοῦ· ἐξ ὄρθρων μέχρις οὗ δῦναι τὸν ἥλιον φονευθήσονται ἐπὶ τὸ αὐτό."
										},
										"_id": "2199",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ διαπορεύσεται ἵππος ἕως τοῦ στήθους αὐτοῦ διὰ τοῦ αἵματος τῶν ἁμαρτωλῶν, καὶ τὸ ἅρμα μέχρι ἀξόνων καταβήσεται."
										},
										"_id": "2200",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ καταβήσονται ἄγγελοι καταδύνοντες εἰς τὰ ἀπόκρυφα ἐν ἡμέρᾳ ἐκείνῃ· οἵτινες ἐβοήθουν τῇ ἀδικίᾳ καὶ συστραφήσονται εἰς ἕνα τόπον καὶ ὁ ὕψιστος"
											},
											"_id": "2201",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "ἐγερθήσενται"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "ἐγερθήσεται"
												}
											],
											"_id": "2202",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἐν ἡμέρᾳ κρίσεως ποιῆσαι ἐκ πάντων κρίσιν μεγάλην,"
											},
											"_id": "2203",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ τάξει φυλακὴν ἐπὶ πάντας τοὺς δικαίους καὶ ἁγίους τῶν ἁγίων ἀγγέλων, καὶ τηρηθήσονται ὡς κόριον ὀφθαλμοῦ ἕως οὗ ἐκλείπῃ τὰ κακὰ καὶ ἁμαρτία. καὶ ἀπ᾽ ἐκείνου ὑπνώσουσιν εὐσεβεῖς ὕπνον ἡδύν, καὶ οὐκ ἔσται οὐκέτι ὁ ἐκφοβῶν αὐτούς."
										},
										"_id": "2204",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "τότε ὄψονται οἱ φρόνιμοι τῶν ἀνθρώπων καὶ κατανοήσουσιν οἱ υἱοὶ τῆς γῆς ἐπὶ τοὺς λόγους τούτους τῆς ἐπιστολῆς ταύτης, καὶ"
											},
											"_id": "2205",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "γνώσθηναι"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "γνώσονται"
												}
											],
											"_id": "2206",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ὅτι οὐ δύναται ὁ πλοῦτος αὐτῶν διασῶσαι αὐτοὺς ἐν τῇ"
											},
											"_id": "2207",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "πτωσις"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "πτώσει"
												}
											],
											"_id": "2208",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "τῆς ἀδικίας."
											},
											"_id": "2209",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν οἱ ἄδικοι ὅταν ἐκθλίβητε τοὺς δικαίους ἐν ἡμέρᾳ ἀνάγκης στερεᾶς καὶ φυλάξητε αὐτοὺς ἐν πυρί, ὅτι κομιεῖσθε κατὰ τὰ ἔργα ὑμῶν."
										},
										"_id": "2210",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν σκληροκάρδιοι, ἀγρυπνοῦντες νοῆσαι τὸ κακόν· περιέχει ὑμᾶς φόβος, καὶ οὐκ ἔστιν ὁ ἀντιλαμβανόμενος ὑμῶν."
										},
										"_id": "2211",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐαὶ ὑμῖν πᾶσιν τοῖς ἁμαρτωλοῖς ἐπὶ τοῖς ἔργοις τοῦ στόματος ὑμῶν. οὐαὶ ὑμῖν πᾶσιν ἁμαρτωλοῖς ἐπὶ τοῖς λόγοις τοῦ στόματος ὑμῶν καὶ ἐπὶ τοῖς [ἔργοις] τῶν χειρῶν ὑμῶν ὅτι ἀπὸ τῶν ἁγίων ἔργων ἀπεπλα[νήθητε] . . ."
										},
										"_id": "2212",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . πᾶσα νεφέλη καὶ ὁμίχλη καὶ δρόμος καὶ ὄμβρος . . . ἐπὶ ταῖς ἁμαρτίαις ὑμῶν."
										},
										"_id": "2213",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "δίδοτε οὖν ὄμβρῳ δῶρα ἵνα μὴ [κωλυθῇ κα]ταβῆναι ὑμῖν, καὶ δρόσῳ κα[ὶ νεφέλῃ] καὶ ὁμίχλῃ· χρυσίον διαγράψα[τε ἵνα κα]ταβῶσιν·"
										},
										"_id": "2214",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὅτι ἐὰν ἐπιρρίψῃ ἐφ᾽ ὑμ[ᾶς χι]ὼν καὶ πάχνη καὶ ψῦχος αὐτῆς, καὶ οἱ ἄνεμοι καὶ ὁ παγετὸς αὐτῶν, καὶ πᾶσαι αἱ μάστιγες αὐτῶν, οὐ δύνασθε ὑποστῆναι ἔμπροσθεν ψύχους καὶ τῶν μαστίγων αὐτῶν."
										},
										"_id": "2215",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								}
							],
							"_number": "100"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "κατανοήσατε τοίνυν, υἱοὶ τῶν ἀνθρώπων, τὰ ἔργα τοῦ ὑψίστου καὶ φοβήθητε τοῦ ποιῆσαι τὸ πονηρὸν ἐναντίον αὐτοῦ."
										},
										"_id": "2216",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἐὰν ἀποκλείσῃ τὰς θυρίδας τοῦ οὐρανοῦ καὶ κωλύσῃ τὴν δρόσον καὶ τὸν ὄμβρον καταβῆναι εἵνεκα ὑμῶν, τί ποιήσετε;"
										},
										"_id": "2217",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἐὰν ἀποστείληται τὸν θυμὸν αὐτοῦ ἐφ᾽ ὑμᾶς καὶ ἐπὶ τὰ ἔργα ὑμῶν, οὐχὶ ἔσεσθε δεόμενοι αὐτοῦ; διὰ τί ὑμεῖς λαλεῖτε τῷ στόματι ὑμῶν μεγάλα καὶ σκληρὰ ἐπὶ τῇ μεγαλωσύνῃ αὐ[τοῦ;"
										},
										"_id": "2218",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὁρᾶ]τε τοὺς ναυκλήρους τοὺς πλωιζομένους τὴν θάλασσαν, ὑπὸ τοῦ κ[λύδω]νος καὶ χειμῶνος σεσαλευμένα τὰ πλοῖα αὐτῶν,"
										},
										"_id": "2219",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ χειμαζόμενοι πάντες φοβοῦνται, ἔξω δὲ τὰ"
											},
											"_id": "2220",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "[...]"
												},
												{
													"_option": "1",
													"_mss": "Black ",
													"__text": "[ἀγαθὰ πάντα]"
												},
												{
													"_option": "2",
													"_mss": "Bonner ",
													"__text": "[χρήματα πάντα]"
												}
											],
											"_id": "2221",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ τὰ ὑπάρχοντα αὐτῶν ἐκβάλλουσιν εἰς τὴν θάλασσαν, καὶ ὑ̣π̣ο̣π̣[τεύουσιν] ἐν τῇ καρδίᾳ αὐτῶν ὅτι ἡ [θάλασσα κα]ταπίεται αὐτοὺς καὶ ἐν αὐτ[ῇ ἀπολοῦνται]."
											},
											"_id": "2222",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οὐχὶ πᾶσα ἡ θάλασσα καὶ [πάντα τὰ] ὕδατα αὐτῆς ἔργον τοῦ ὑψ[ίστου ἐστί,] καὶ αὐτὸς συνεστήσατο τὰ π[έρατα αὐ]τῶν, καὶ συνέδησεν αὐτ[ήν, καὶ περι]έφραξεν αὐτὴν ἄμμῳ;"
										},
										"_id": "2223",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "[καὶ ἀπὸ τῆς] ἐμβριμήσεως αὐτοῦ φ[οβοῦνται καὶ ξη]ραίνονται, καὶ οἱ ἰχθύες . . ."
										},
										"_id": "2224",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . [γῆν] καὶ πάντα τὰ ἐν αὐτοῖς; καὶ τίς ἔδωκεν ἐπιστήμην πᾶσιν τοῖς κινουμένοις ἐν τῇ θαλάσσῃ; οἱ ναύκληροι τὴν θάλασσαν φοβοῦνται."
										},
										"_id": "2225",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								}
							],
							"_number": "101"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὅταν ἐκβάλῃ ἐφ᾽ ὑμᾶς τὸν κλύδωνα τοῦ πυρὸς τῆς καύσεως ὑμῶν, ποῦ ἀποδράντες σωθήσεσθε; καὶ ὅταν δῷ ἐφ᾽ ὑμᾶς φωνὴν αὐτοῦ,"
										},
										"_id": "2226",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 "
												},
												{
													"_option": "1",
													"_mss": "Bonner ",
													"__text": "οὐκ"
												}
											],
											"_id": "2227",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἔσεσθε συνσειόμενοι καὶ φοβούμενοι ἤχῳ μεγάλῳ {καὶ} τὴν γῆν σύμπασαν σειομένην καὶ τρέμουσαν καὶ συνταρασσομένην."
											},
											"_id": "2228",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ οἱ ἄγγελοι συντελοῦντες τὸ συνταχθὲν αὐτοῖς, καὶ ὁ οὐρανὸς καὶ οἱ φωστῆρες σειόμενοι καὶ τρέμοντες· ἅπαντες οἱ υἱοὶ τῆς γῆς καὶ ὑμεῖς ἁμαρτωλοὶ ἐπικατάρατοι εἰς τὸν αἰῶνα· οὐκ ἔστιν ὑμῖν χαίρειν."
										},
										"_id": "2229",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "θαρσεῖτε, ψυχαὶ τῶν δικαίων τῶν ἀποθανόντων, τῶν δικαίων καὶ τῶν εὐσεβῶν,"
										},
										"_id": "2230",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ μὴ λυπεῖσθε ὅτι κατέβησαν αἱ ψυχαὶ ὑμῶν εἰς ᾅδου μετὰ λύπης καὶ οὐκ ἀπηντήθη τῷ σώματι τῆς σαρκὸς ὑμῶν ἐν τῇ ζωῇ ὑμῶν κατὰ τὴν ὁσιότητα ὑμῶν, ἐπεὶ αἱ ἡμέραι ἃς ἦτε ἡμέραι ἦσαν ἁμαρτωλῶν καὶ καταράτων ἐπὶ τῆς γῆς."
										},
										"_id": "2231",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὅταν ἀποθάνητε, τότε ἐροῦσιν οἱ ἁμαρτωλοὶ ὅτι εὐσεβεῖς κατὰ τὴν εἱμαρμένην ἀπεθάνοσαν, καὶ τί αὐτοῖς περιεγένετο ἐπὶ τοῖς ἔργοις αὐτῶν;"
										},
										"_id": "2232",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ αὐτοὶ ὁμοίως ἡμῖν ἀπεθάνοσαν. ἴδετε οὖν ὡς ἀποθνήσκουσιν μετὰ λύπης καὶ σκότους, καὶ τί αὐτοῖς ἐγένετο περισσόν;"
										},
										"_id": "2233",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἀπὸ τοῦ νῦν ἀναστήτωσαν καὶ σωθήτωσαν, καὶ ὄψονται εἰς τὸν αἰῶνα ἡμᾶς φαγεῖν καὶ πιεῖν."
										},
										"_id": "2234",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "τοιγαροῦν ἁρπάσαι καὶ ἁμαρτάνειν καὶ λωποδυτεῖν καὶ ἐγκτᾶσθαι καὶ [ἰδεῖν] ἡμέρας ἀγαθάς."
										},
										"_id": "2235",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἴδετε οὖν οἱ δικαιοῦντες [ἑαυτ]ούς, ὁποία ἐγένετο αὐτῶν ἡ καταστροφή, ὅτι πᾶσα δικαιοσύνη οὐχ εὐρέθη ἐν αὐτοῖς ἕως ἀπέθανον καὶ ἀπώλοντο"
										},
										"_id": "2236",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἐγένοντο ὡς οὐκ ὄντες καὶ κατέβησαν αἱ ψυχαὶ αὐτῶν μετ᾽ ὀδύνης εἰς ᾅδου . . ."
										},
										"_id": "2237",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								}
							],
							"_number": "102"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἐγὼ ὀμνύω ὑμῖν . . ."
										},
										"_id": "2238",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἐπίσταμαι τὸ μυστήριον τοῦτο· ἀν[έγνων] γὰρ τὰς πλάκας τοῦ οὐρανοῦ καὶ εἶδον τὴν γραφὴν ἀναγκαίαν· ἔγνων τὰ γ[εγραμμέ]να ἐν αὐταῖς καὶ ἐγκεκολαμμέν[α περὶ] ὑμῶν,"
										},
										"_id": "2239",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ὅτι ἀγαθὰ καὶ ἡ χαρὰ καὶ ἡ τ[ιμὴ] ἡ ἡτοίμασται καὶ ἐγγέγραπται ταῖς ψ[υχαῖς] τῶν"
											},
											"_id": "2240",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "ἀποθανόντων"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "ἀποθανόν]των["
												}
											],
											"_id": "2241",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "εὐσεβῶν·"
											},
											"_id": "2242",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "3"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ"
											},
											"_id": "2243",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "χαιρήσονται"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "χαιρήσ]ονται["
												}
											],
											"_id": "2244",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "καὶ οὐ μὴ ἀπὸλωται τὰ"
											},
											"_id": "2245",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "πνεύματα"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "]πνεύ[ματα"
												}
											],
											"_id": "2246",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "αὐτῶν οὐδὲ τὸ"
											},
											"_id": "2247",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "μνημόσυνον"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "μν]ημό[συνον"
												}
											],
											"_id": "2248",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "ἀπὸ προσώπου"
											},
											"_id": "2249",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 7QEnoch ",
												"__text": "τοῦ"
											},
											"_id": "2250",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "μεγάλου εἰς πάσας τὰς"
											},
											"_id": "2251",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "γενεὰς τῶν"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "γ]ε[νεὰς τ]ῶ[ν"
												}
											],
											"_id": "2252",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "αἰώνων. μὴ"
											},
											"_id": "2253",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "CB185 ",
													"__text": "οὖν φοβεῖσθε"
												},
												{
													"_option": "1",
													"_mss": "7QEnoch ",
													"__text": "ο]ὖν [φοβεῖσθ]ε["
												}
											],
											"_id": "2254",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "CB185 ",
												"__text": "τοὺς ὀνειδισμοὺς αὐτῶν."
											},
											"_id": "2255",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὑμεῖς, οἱ νεκροὶ τῶν ἁμαρτωλῶν, ὅταν ἀποθάνητε ἐροῦσιν ἐφ᾽ ὑμῖν, μακάριοι ἁμαρτωλοὶ πάσας τὰς ἡμέρας αὐτῶν ὅσας εἴδοσαν ἐν τῇ ζωῇ αὐτῶν, καὶ ἐνδόξως"
										},
										"_id": "2256",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἀπεθάνοσαν, καὶ κρίσις οὐκ ἐγενήθη ἐν τῇ ζωῇ αὐτῶν."
										},
										"_id": "2257",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "αὐτοὶ ὑμεῖς γινώσκετε ὅτι εἰς ᾅδου κατάξουσιν τὰς ψυχὰς ὑμῶν,"
										},
										"_id": "2258",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἐκεῖ ἔσονται ἐν ἀνάγκῃ μεγάλῃ καὶ ἐν σκότει καὶ ἐν παγίδι καὶ ἐν φλογὶ καιομένῃ, καὶ εἰς κρίσιν μεγάλην εἰσελεύσονται αἱ ψυχαὶ ὑμῶν ἐν πάσαις ταῖς γενεαῖς τοῦ αἰῶνος. οὐαὶ ὑμῖν, οὐκ ἔστιν ὑμῖν χαίρειν."
										},
										"_id": "2259",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μὴ γὰρ εἴπητε οἱ δίκαιοι, ὅσιοι ὄντες ἐν τῇ ζωῇ, τῶν ἡμερῶν τῆς θλίψεως κόπους ἐκοπιάσαμεν, καὶ ἀνηλώμεθα καὶ ὀλίγοι ἐγενήθημεν, καὶ ἀντιλήμπτορα οὐχ εὑρήκαμεν·"
										},
										"_id": "2260",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "συντετριμμένοι καὶ ἀπολώλαμεν, καὶ ἀπηλπίσμεθα καὶ μηκέτι εἰδέναι σωτηρίαν ἡμέραν ἐξ ἡμέρας."
										},
										"_id": "2261",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ἠλπίσαμεν γενέσθαι κεφαλή, ἐγενήθημεν κέρ[κος· ἐκο]πιάσαμεν ἐργαζόμενοι καὶ τῶν ὀψωνίων οὐ κεκυριεύκαμεν. ἐγενήθημεν κατάβρωμα ἁμαρτωλῶν, [οἱ ἄνο]μοι ἐβάρυναν ἐφ᾽ ἡμᾶς τὸν ζυγόν."
										},
										"_id": "2262",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "οἳ κυριεύουσιν, οἱ ἐχθροὶ ἡμῶν ἐγκεντρίζουσιν ἡμᾶς καὶ περικλείουσιν ἡμᾶς· ἐζητήσαμεν πο[ῦ φύγωμεν] ἀπ᾽ αὐτῶν ὅπως ἀναψύχ[ωμεν.] . . ."
										},
										"_id": "2263",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . ἐκράξαμεν ἐπὶ τοὺς καταβάλλοντας καὶ βιαζομένους ἡμᾶς καὶ τὰς ἐντεύξεις ἡμῶν οὐκ ἀπεδέξαντο, οὐδὲ ἐβούλοντο ἐπακοῦσαι τῆς φωνῆς ἡμῶν."
										},
										"_id": "2264",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ οὐκ ἀντελαμβάνοντο ἡμῶν, οὐχ εὑρόντες κατὰ τῶν βιαζομένων καὶ κατεσθόντων ἡμᾶς, ἀλλὰ στερεοῦσιν αὐτοὺς ἐφ᾽ ἡμᾶς· ἀπέκτειναν ἡμᾶς καὶ εἰς ὀλίγους ἤγαγον. καὶ οὐχ ὑποδεικνύουσιν περὶ τῶν πεφονευμένων ἡμῶν, καὶ οὐκ ἀναμιμνήσκουσιν περὶ τῶν ἁμαρτωλῶν αὐτῶν τὰς ἁμαρτίας αὐτῶν."
										},
										"_id": "2265",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								}
							],
							"_number": "103"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὀμνύω ὑμῖν ὅτι οἱ ἄγγελοι ἐν τῷ οὐρανῷ ἀναμιμνήσκουσιν [ὑμῶν] εἰς ἀγαθὸν ἐνώπιον τῆς δόξης τοῦ μεγάλου."
										},
										"_id": "2266",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "θαρσεῖτε δὴ ὅτι ἐπαλαιώθητε ἐν τοῖς κακοῖς καὶ ἐν ταῖς θλίψεσιν· ὡσεὶ φωστῆρες τοῦ οὐρανοῦ ἀναλάμψετε καὶ φανεῖτε, αἱ θυρίδες τοῦ οὐρανοῦ ἀνοιχθήσονται ὑμῖν,"
										},
										"_id": "2267",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἡ κραυγὴ ὑμῶν ἀκουσθήσεται καὶ ἡ κρίσις ὑμῶν ἣν κράζετε καὶ φανεῖται ἐφ᾽ ὅσα συλλαβήσεται ὑμῖν περὶ τῆς θλίψεως ὑμῶν, καὶ ἐκ πάντων ὅστις μετέσχεν τῶν βιαζομένων καὶ κατεσθόντων ὑμᾶς. . . ."
										},
										"_id": "2268",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "[μὴ φοβεῖσθε] τὰ κακὰ ἐν τῇ ἡμέρᾳ τῆς κρίσεως τῆς μεγάλης καὶ οὐ μὴ εὑρεθῆτε ὡς οἱ ἁμαρτωλοί. [ἀλλ᾽ ὑμεῖς οἱ ἁμαρτωλοὶ] σκυλήσεσθε καὶ κρίσις αἰώνιος ἐξ ὑμῶν ἔσται εἰς πάσας τὰς γενεὰς τῶν αἰώνων."
										},
										"_id": "2269",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μὴ φοβεῖσθε οἱ δίκαιοι ὅταν ἴδητε τοὺς ἁμαρτωλοὺς κατισχύοντας καὶ εὐοδουμένους, καὶ μὴ μέτοχοι αὐτῶν γίνεσθε, ἀλλὰ μακρὰν ἀπέχεσθε ἀπὸ πάντων τῶν ἀδικημάτων αὐτῶν."
										},
										"_id": "2270",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μὴ γὰρ εἴπητε οἱ ἁμαρτωλοὶ [ὅτι] οὐ μὴ ἐκζητηθῶσιν αἱ ἁμαρτίαι ὑμῶν [ἐξ] ἡμερῶν."
										},
										"_id": "2271",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ νῦν ἀποδεικνύω ὑμῖν ὅτι φῶς καὶ σκότος ἡμέρα καὶ νὺξ ἐποπτεύουσιν τὰς ἁμαρτίας ὑμῶν πάσας."
										},
										"_id": "2272",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μὴ πλανᾶσθε τῇ καρδίᾳ ὑμῶν μηδὲ ψεύδεσθε μηδὲ ἐξαλλοιώσητε τοὺς λόγους τῆς ἀληθείας, μηδὲ καταψεύδεσθε τῶν [λόγων τοῦ] ἁγίου, καὶ μὴ δότε ἔπαινον ταῖς [εἰκόσιν ὑ]μῶν· οὐ γὰρ εἰς δικαίωμα εἰσάγ[ουσιν πάντα τὰ ψεύδ]η καὶ πᾶσα [ἡ πλάνη] . . ."
										},
										"_id": "2273",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . τῆς ἀληθείας ἐξαλλοιοῦσιν καὶ ἀντιγράφουσιν οἱ ἁμαρτωλοὶ καὶ ἀλλάσσουσιν τοὺς πολλοὺς, καὶ ψεύδονται καὶ πλάσσουσιν πλάσματα μεγάλα καὶ τὰς γραφὰς ἀναγράφουσιν ἐπὶ τοῖς ὀνόμασιν αὐτῶν·"
										},
										"_id": "2274",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὄφελον πάντας τοὺς λόγους μου γράφωσιν ἐπ᾽ ἀληθείας ἐπὶ τὰ ὀνόματα αὐτῶν καὶ μήτε ἀφέλωσιν μήτε ἀλλοιώσωσιν τῶν λόγων τούτων, ἀλλὰ πάντα ἐπ᾽ ἀληθείας γράφωσιν ἃ ἐγὼ διαμαρτυροῦμαι αὐτοῖς."
										},
										"_id": "2275",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ πάλιν ἐγὼ γινώσκω μυστήριον δεύτερον, ὅτι δικαίοις καὶ ὁσίοις καὶ φρονίμοις δοθήσονται αἱ βίβλοι μου εἰς χαρὰν ἀληθείας,"
										},
										"_id": "2276",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ αὐτοὶ πιστεύσουσιν αὐταῖς καὶ ἐν αὐταῖς χαρήσονται καὶ ἀγαλλιάσονται πάντες οἱ δίκαιοι μαθεῖν ἐξ αὐτῶν πᾶσας τὰς ὁδοὺς τῆς ἀληθείας."
										},
										"_id": "2277",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								}
							],
							"_number": "104"
						},
						{
							"div": {
								"unit": {
									"reading": {
										"_option": "0",
										"_mss": "CB185 ",
										"__text": ". . ."
									},
									"_id": "2278",
									"_group": "0",
									"_parallel": ""
								},
								"_number": "1"
							},
							"_number": "105"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "μετὰ δὲ χρόνον ἔλαβεν Μαθουσάλεκ τῷ υἱῷ μου γυναῖκα καὶ ἔτεκεν υἱὸν καὶ ἐκάλεσεν τὸ ὄνομα αὐτοῦ Λάμεχ. ἐταπεινώθη ἡ δικαιοσύνη μέχρι τῆς ἡμέρας ἐκείνης. καὶ ὅτε εἰς ἡλικίαν ἐπῆλθεν, ἔλαβεν αὐτῷ γυναῖκα καὶ ἔτεκεν αὐτῷ παιδίον,"
										},
										"_id": "2279",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὅτε ἐγεννήθη τὸ παιδίον ἦν τὸ σῶμα λευκότερον χιόνος καὶ πυρρότερον ῥόδου, τὸ τρίχωμα πᾶν λευκὸν καὶ ὡς ἔρια λευκὰ καὶ οὖλον καὶ ἔνδοξον. καὶ ὅτε ἀνέῳξεν τοὺς ὀφθαλμούς, ἔλαμψεν ἡ οἰκία ὡσεὶ ἥλιος."
										},
										"_id": "2280",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἀνέστη ἐκ τῶν χειρῶν τῆς μαίας καὶ ἀνέῳξεν τὸ στόμα καὶ εὐλόγησεν τῷ κυρίῳ·"
										},
										"_id": "2281",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἐφοβήθη Λάμεχ ἀπ᾽ αὐτοῦ καὶ ἔφυγεν καὶ ἦλθεν πρὸς Μαθουσάλεκ τὸν πατέρα αὐτοῦ καὶ εἶπεν αὐτῷ,"
										},
										"_id": "2282",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "τέκνον ἐγεννήθη μου ἀλλοῖον, οὐχ ὅμοιον τοῖς ἀνθρώποις ἀλλὰ τοῖς τέκνοις τῶν ἀγγέλων τοῦ οὐρανοῦ, καὶ ὁ τύπος ἀλλοιότερος, οὐχ ὅμοιος ἡμῖν· τὰ ὄμματά ἐστιν ὡς ἀκτῖνες τοῦ ἡλίου, καὶ ἔνδοξον τὸ πρόσωπον·"
										},
										"_id": "2283",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὑπολαμβάνω ὅτι οὐκ ἔστιν ἐξ ἐμοῦ ἀλλὰ ἐξ ἀγγέλου, καὶ εὐλαβοῦμαι αὐτὸν μήποτέ τι ἔσται ἐν ταῖς ἡμέραις αὐτοῦ ἐν τῇ γῇ."
										},
										"_id": "2284",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ παραιτοῦμαι, π[άτερ, καὶ] δέομαι, βάδισον πρὸς Ἑνὼ[χ τὸν πατέρα ἡμῶν καὶ ἐρώτησον] . . ."
										},
										"_id": "2285",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": ". . . [ἦλθ]εν πρὸς ἐμὲ εἰς τὰ τέρματα τῆς γῆς οὗ [εἶδ]εν τότε εἶναι με καὶ εἶπέν μοι, πάτερ [μου] ἐπάκουσον τῆς φωνῆς μου καὶ ἧκε [πρὸς] ἐμέ. καὶ ἤκουσα τὴν φωνὴν αὐτοῦ καὶ ἦλθον πρὸς αὐτὸν καὶ εἶπα, ἰδοὺ πάρειμι τέκνον· διὰ τί ἐλήλυθας πρὸς ἐμέ, τέκνον;"
										},
										"_id": "2286",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἀπεκρίθη λέγων, δι᾽ ἀνάγκην μεγάλην ἦλθον ὧδε, πάτερ·"
										},
										"_id": "2287",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ νῦν ἐγεννήθη τέκνον Λάμεχ τῷ υἱῷ μου, καὶ ὁ τύπος αὐτοῦ καὶ ἡ εἰκὼν αὐτοῦ {οὐχ ὅμοιος ἀνθρώποις καὶ τὸ χρῶμα αὐτοῦ} λευκότερον χιόνος καὶ πυρρότερον ῥόδου, καὶ τὸ τρίχωμα τῆς κεφαλῆς αὐτοῦ λευκότερον ἐρίων λευκῶν, καὶ τὰ ὄμματα αὐτοῦ ἀφόμοια ταῖς τοῦ ἡλίου ἀκτῖσιν,"
										},
										"_id": "2288",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἀνέστη ἀπὸ τῶν τῆς μαίας χειρῶν καὶ ἀνοίξας τὸ στόμα εὐλόγησεν τὸν κύριον τοῦ αἰῶνος·"
										},
										"_id": "2289",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἐφοβήθη ὁ υἱός μου Λάμεχ, καὶ ἔφυγεν πρὸς ἐμέ, καὶ οὐ πιστεύει ὅτι υἱὸς αὐτοῦ ἐστιν, ἀλλὰ ὅτι ἐξ ἀγγέλων . . . τὴν ἀκρίβειαν ἣν ἔχεις καὶ τὴν ἀλήθειαν."
										},
										"_id": "2290",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "τότε ἀπεκρίθην λέγων, ἀνακαινίσει ὁ κύριος πρόσταγμα ἐπὶ τῆς γῆς, καὶ τὸν αὐτὸν τρόπον τέκνον τεθέαμαι καὶ ἐσήμανά σοι· ἐν γὰρ τῇ γενεᾷ Ἰάρεδ τοῦ πατρός μου παρέβησαν τὸν λόγον κυρίου ἀπὸ τῆς διαθήκης τοῦ οὐρανοῦ."
										},
										"_id": "2291",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἰδοὺ ἁμαρτάνουσιν καὶ παραβαίνουσιν τὸ ἔθος, καὶ μετὰ γυναικῶν συγγίνονται καὶ μετ᾽ αὐτῶν ἁμαρτάνουσιν καὶ ἔγημαν ἐξ αὐτῶν, 17a. καὶ τίκτουσιν οὐχ ὁμοίους πνεύμασιν ἀλλὰ σαρκίνους·"
										},
										"_id": "2292",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ἔσται ὀργὴ μεγάλη ἐπὶ τῆς γῆς καὶ κατακλυσμός, καὶ ἔσται ἀπώλεια μεγάλη ἐπὶ ἐνιαυτὸν ἕνα·"
										},
										"_id": "2293",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ τόδε τὸ παιδίον τὸ γεννηθὲν καταλειφθήσεται, καὶ τρία αὐτοῦ͂ τέκνα σωθήσεται ἀποθανόντων τῶν ἐπὶ τῆς γῆς·"
										},
										"_id": "2294",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ πραϋνεῖ τὴν γῆν ἀπὸ τῆς οὔσης ἐν αὐτῇ φθορᾶς."
										},
										"_id": "2295",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "17b"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ νῦν λέγε Λάμεχ ὅτι τέκνον σου ἐστιν δικαίως καὶ ὁσίως, [καὶ] κάλεσον αὐτοῦ τὸ ὄνομα [Νῶε]· αὐτὸς γὰρ ἔσται ὑμῶν κατάλειμμα ἐφ᾽ οὗ ἂν καταπαύσητε καὶ {οἱ} υἱοὶ αὐτοῦ ἀπὸ τῆς φθορᾶς τῆς γῆς καὶ ἀπὸ πάντων τῶν ἁμαρτωλῶν καὶ ἀπὸ πασῶν τῶν συντελειῶν ἐπὶ τῆς γῆς . . ."
										},
										"_id": "2296",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "18"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "ὑπέδειξέν μοι καὶ ἐμήνυσεν, καὶ ἐν ταῖς πλαξὶν τοῦ οὐρανοῦ ἀνέγνων αὐτά."
										},
										"_id": "2297",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "19"
								}
							],
							"_number": "106"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "Τότε τεθέαμαι τὰ ἐγγεγραμμένα ἐπ᾽ αὐτῶν, ὅτι γενεὰ γενεᾶς κακ[ίων ἔσται], καὶ εἶδον τόδε μέχρις τοῦ ἀνασ[τῆναι] γενεὰν δικαιοσύνης καὶ ἡ κακία ἀπολεῖται καὶ ἡ ἁμαρτία ἀλλάξει ἀπὸ τῆς γῆς καὶ τὰ ἀγαθὰ ἥξει ἐπὶ τῆς γῆς ἐπ᾽ αὐτούς."
										},
										"_id": "2298",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ νῦν ἀπότρεχε τέκνον καὶ σήμανον Λάμεχ τῷ υἱῷ σου ὅτι τὸ παιδίον τοῦτο τὸ γεννηθὲν τέκνον αὐτοῦ ἐστιν δικαίως καὶ οὐ ψευδῶς."
										},
										"_id": "2299",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "CB185 ",
											"__text": "καὶ ὅτε ἤκουσεν Μαθουσάλεκ τοὺς λόγους Ἑνώχ τοῦ πατρὸς αὐτοῦ, μυστηριακῶς γὰρ ἐδήλωσεν αὐτῷ, [ἐπέστρεψεν καὶ ἐδήλωσεν αὐτῷ.] καὶ ἐκλήθη τὸ ὄνομα αὐτοῦ Νῶε, εὐφραίνων τὴν γῆν ἀπὸ τῆς ἀπωλείας."
										},
										"_id": "2300",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								}
