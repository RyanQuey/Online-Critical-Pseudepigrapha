											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὄρεσιν μεγάλοις"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "ὁράσει μεγάλη"
												}
											],
											"_id": "2023",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "καὶ ἐν πυρὶ καιομένους."
											},
											"_id": "2024",
											"_group": "0",
