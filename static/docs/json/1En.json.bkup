									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Bertalotto p  ",
											"__text": "ቃለ፡​በረከት፡​ዘሄኖከ፡​ዘከመ፡​ባረከ፡​ኅሩያነ፡​ወጻድቃነ፡​እለ፡​ሀለዉ፡​ይኩኑ፡​በዕለተ፡​ምንዳቤ፡​ለአሰስሎ፡​ኵሎ፡​እኩያን፡​ወረሲዓን፡​"
										},
										"_id": "1"
									},
									"_number": "1"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Bertalotto p ",
												"__text": "ወአውሥአ፡​ሄኖክ፡​ወይቤ፡​ብእሲ፡​ጻድቅ፡​ዘእምኀበ፡​እግዚአብሔር፡​እንዘ፡​አዕይንቲሁ፡​ክሡታት፡​ወይሬኢ፡​"
											},
											"_id": "2",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "p ",
													"__text": "ራዕየ፡​"
												},
												{
													"_option": "1",
													"_mss": "Bertalotto ",
													"__text": "ራእየ፡​"
												}
											],
											"_id": "3",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Bertalotto p ",
												"__text": "ቅዱሰ፡​ዘበሰማያት፡​ዘአርአዩኒ፡​መላእክት፡​ወሰማዕኩ፡​እምኀቤሆሙ፡​ኵሎ፡​ወአእመርኩ፡​አነ፡​ዘእሬኢ፡​ወአኮ፡​ለዝ፡​ትውልድ፡​አላ፡​ለዘ፡​ይመጽኡ፡​ትውልድ፡​ርሑቃን፡​"
											},
											"_id": "4",
