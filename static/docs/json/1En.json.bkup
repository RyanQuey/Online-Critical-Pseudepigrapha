											"_option": "0",
											"_mss": "BL ",
											"__text": "ne non ex eo natus esset nisi nontius dei et uenit ad patrem suum mathusalem et narrauit illi omnia."
										},
										"_id": "1726",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "dixit mathusalem Ego autem non possum scire nisi eamus ad patrem nostrum enoc."
										},
										"_id": "1727",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "quum autem uidit enoc filium suum mathusalem uenientem ad se [et] ait Quid est quod uenisti ad me, nate ?"
										},
										"_id": "1728",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "dixit Quod"
										},
										"_id": "1729",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "natus est filio suo nomine lamech cui oculi sunt sicut radi solis, capilli[s] eius candidiores septies niue, corpori autem eius nemo hominum potest intueri,"
										},
										"_id": "1730",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "et surexit inter manus obstetricis suae eadem hora qua procidit de utero matris suae {et ad}orauit dominum uiuentem in secula et laudauit:"
										},
										"_id": "1731",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "et timuit lamech."
										},
										"_id": "1732",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "et dixit enoc. Nontiatum est mihi, fili,"
										},
										"_id": "1733",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL "
										},
										"_id": "1734",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "quia post quingentos annos mittet deus cataclismum aquae ut deleat omnem creaturam xl {diebus, sicut} ostendit oculis nostris,"
										},
										"_id": "1735",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "15"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "et erunt illi iii filii, et erunt nomina filiorum e ius sem cham iafeth,"
										},
										"_id": "1736",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "16"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL "
										},
										"_id": "1737",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "17b"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "BL ",
											"__text": "et ipse uocabitur noe qui interpretatur requies quia requiem prestabit in archam."
										},
										"_id": "1738",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "18"
								}
							],
							"_number": "106"
						}
					]
				},
