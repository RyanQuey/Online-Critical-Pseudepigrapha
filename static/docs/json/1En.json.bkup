										}
									],
									"_number": "3"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "τότε εἶπον Διὰ ποίαν αἰτίαν ἐπεδέθησαν, καὶ διὰ"
											},
											"_id": "2025",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "τί"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "ποίαν αἰτίαν"
												}
											],
											"_id": "2026",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὧδε ἐρίφησαν;"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "ἐρίφησαν ὧδε;"
												}
											],
											"_id": "2027",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "4"
								},
								{
									"unit": [
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "τότε"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "καὶ"
												}
											],
											"_id": "2028",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "εἶπέν μοι Οὐριήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων"
											},
											"_id": "2029",
											"_group": "0",
											"_parallel": ""
										},
