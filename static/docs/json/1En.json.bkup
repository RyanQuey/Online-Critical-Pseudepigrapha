									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "POxy2069 ",
											"__text": "... ] τῆς χειρός μ[ου ... ] υἱῶν τῆς [ ..."
										},
										"_id": "2122",
