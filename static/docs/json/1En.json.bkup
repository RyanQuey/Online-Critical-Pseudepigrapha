													"_option": "1",
													"_mss": "Gizeh Gizeh2 ",
													"__text": "ὁ"
												}
											],
											"_id": "2030",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "μετ᾽ ἐμοῦ"
											},
											"_id": "2031",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh Gizeh2 ",
													"__text": "ἦν"
												},
												{
													"_option": "1",
													"_mss": "Gizeh Gizeh2 ",
													"__text": "ὤν"
												}
											],
											"_id": "2032",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "— καὶ αὐτὸς"
											},
											"_id": "2033",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ἡγεῖτο αὐτῶν"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "αὐτῶν ἡγεῖτο"
												}
											],
											"_id": "2034",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "— καὶ εἶπέν μοι Ἑνώχ, περὶ τίνος ἐρωτᾷς, ἢ περὶ τίνος τὴν ἀλήθειαν φιλοσπευδεῖς;"
											},
											"_id": "2035",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "5"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "οὗτοί εἰσιν τῶν ἀστέρων τοῦ οὐρανοῦ οἱ παραβάντες τὴν ἐπιταγὴν τοῦ κυρίου, καὶ ἐδέθησαν ὧδε μέχρι τοῦ"
											},
											"_id": "2036",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "πληρῶσαι"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "πληρωθῆναι"
												}
											],
											"_id": "2037",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "μύρια ἔτη, τὸν χρόνον τῶν ἁμαρτημάτων αὐτῶν."
											},
											"_id": "2038",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "6"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "Κἀκεῖθεν ἐφώδευσα εἰς ἄλλον τόπον τούτου φοβερώτερον, καὶ τεθέαμαι ἔργα"
											},
											"_id": "2039",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "φοβερώτερα,"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "φοβερά,"
												}
											],
											"_id": "2040",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "πῦρ μέγα ἐκεῖ καιόμενον καὶ φλεγόμενον, καὶ διακοπὴν εἶχεν ὁ τόπος ἕως τῆς ἀβύσσου, πλήρης στύλων πυρὸς"
											},
											"_id": "2041",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "μεγάλου"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "μεγάλων"
												}
											],
											"_id": "2042",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "καταφερομένων· οὔτε μέτρον οὔτε"
											},
											"_id": "2043",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "πλάτος"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "μέγεθος"
												}
											],
											"_id": "2044",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ἠδυνήθην ἰδεῖν οὐδὲ εἰκάσαι."
											},
											"_id": "2045",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "7"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "τότε εἶπον Ὡς φοβερὸς ὁ τόπος"
											},
											"_id": "2046",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh "
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 ",
													"__text": "οὕτος"
												}
											],
											"_id": "2047",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "καὶ ὡς δεινὸς τῇ ὁράσει."
											},
											"_id": "2048",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "8"
								},
								{
									"unit": [
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "τότε ἀπεκρίθη μοι"
											},
											"_id": "2049",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": [
												{
													"_option": "0",
													"_mss": "Gizeh ",
													"__text": "ὁ εἷς τῶν ἁγίων ἀγγέλων ὃς μετ᾽ ἐμοῦ ἦν,"
												},
												{
													"_option": "1",
													"_mss": "Gizeh2 "
												}
											],
											"_id": "2050",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "καὶ εἶπέν"
											},
											"_id": "2051",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh ",
												"__text": "μοι Ἑνώχ, διὰ τί ἐφοβήθης; οὕτως καὶ ἐπτοήθης; καὶ ἀπεκρίθην Περὶ τούτου τοῦ φοβεροῦ καὶ περὶ τῆς προσόψεως τῆς δεινῆς."
											},
											"_id": "2052",
											"_group": "0",
											"_parallel": ""
										}
									],
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶπεν Οὗτος ὁ τόπος δεσμωτήριον ἀγγέλων· ὧδε συνσχεθήσονται μέχρι αἰῶνος εἰς τὸν αἰῶνα."
										},
										"_id": "2053",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								}
							],
							"_number": "21"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Κἀκεῖθεν ἐφώδευσα εἰς ἄλλον τόπον, καὶ ἔδειξέν μοι πρὸς δυσμὰς ἄλλο ὄρος μέγα καὶ ὑψηλόν, πέτρας στερεάς."
										},
										"_id": "2054",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τέσσαρες τόποι ἐν αὐτῷ κοῖλοι, βάθος ἔχοντες καὶ λίαν λεῖοι, τρεῖς αὐτῶν σκοτινοὶ καὶ εἷς φωτινός, καὶ πηγὴ ὕδατος ἀνὰ μέσον αὐτοῦ. καὶ εἶπον Πῶς λεῖα τὰ κοιλώματα ταῦτα καὶ ὁλοβαθῆ καὶ σκοτινὰ τῇ ὁράσει;"
										},
										"_id": "2055",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπεκρίθη Ῥαφαήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὃς μετ᾽ ἐμοῦ ἦν, καὶ εἶπέν μοι Οὗτοι οἱ τόποι οἱ κοῖλοι, ἵνα ἐπισυνάγωνται εἰς αὐτοὺς τὰ πνεύματα τῶν ψυχῶν τῶν νεκρῶν. εἰς αὐτὸ τοῦτο ἐκρίθησαν, ὧδε ἐπισυνάγεσθαι πάσας τὰς ψυχὰς τῶν ἀνθρώπων."
										},
										"_id": "2056",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὗτοι οἱ τόποι εἰς ἐπισύνσχεσιν αὐτῶν ἐποίησαν μέχρι τῆς ἡμέρας τῆς κρίσεως αὐτῶν καὶ μέχρι τοῦ διορισμοῦ καὶ διορισμένου χρόνου ἐν ᾧ ἡ κρίσις ἡ μεγάλη ἔσται ἐν αὐτοῖς."
										},
										"_id": "2057",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τεθέαμαι ἀνθρώπους νεκροὺς ἐντυγχάνοντας, καὶ ἡ φωνὴ αὐτοῦ μέχρι τοῦ οὐρανοῦ προέβαινεν καὶ ἐνετύγχανεν."
										},
										"_id": "2058",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἠρώτησα Ῥαφαὴλ τὸν ἄγγελον ὃς μετ᾽ ἐμοῦ ἦν, καὶ εἶπα αὐτῷ Τοῦτο τὸ πνεῦμα τὸ ἐντυγχάνον τίνος ἐστιν, δι᾽ ὃ οὕτως ἡ φωνὴ αὐτοῦ προβαίνει καὶ ἐντυγχάνει ἕως τοῦ οὐρανοῦ;"
										},
										"_id": "2059",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπεκρίθη μοι λέγων Τοῦτο τὸ πνεῦμά ἐστιν τὸ ἐξελθὸν ἀπὸ Ἄβελ ὃν ἐφόνευσε Κάιν ὁ ἀδελφός, καὶ Ἄβελ ἐντυγχάνει περὶ αὐτοῦ μέχρι τοῦ ἀπολέσαι τὸ σπέρμα αὐτοῦ ἀπὸ προσώπου τῆς γῆς, καὶ ἀπὸ τοῦ σπέρματος τῶν ἀνθρώπων ἀφανίσθη τὸ σπέρμα αὐτοῦ."
										},
										"_id": "2060",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἠρώτησα περὶ τῶν κυκλωμάτων πάντων, διὰ τί ἐχωρίσθησαν ἓν ἀπὸ τοῦ ἑνός;"
										},
										"_id": "2061",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "8"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπεκρίθη μοι λέγων Οὗτοι οἱ τρεῖς ἐποιήθησαν χωρίζεσθαι τὰ πνεύματα τῶν νεκρῶν· καὶ οὕτως ἐχωρίσθη εἰς τὰ πνεύματα τῶν δικαίων, οὗ ἡ πηγὴ τοῦ ὕδατος ἐν αὐτῷ φωτινή·"
										},
										"_id": "2062",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "9"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὕτως ἐκτίσθη τῶν ἁμαρτωλῶν, ὅταν ἀποθάνωσιν καὶ ταφῶσιν εἰς τὴν γῆν, καὶ κρίσις οὐκ ἐγενήθη ἐπ᾽ αὐτῶν ἐν τῇ ζωῇ αὐτῶν."
										},
										"_id": "2063",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "10"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὧδε χωρίζεται τὰ πνεύματα αὐτῶν εἰς τὴν μεγάλην βάσανον ταύτην, μέχρι τῆς μεγάλης ἡμέρας τῆς κρίσεως, τῶν μαστίγων καὶ τῶν βασάνων τῶν κατηραμένων μέχρι αἰῶνος· ἦν ἀνταπόδοσις τῶν πνευμάτων· ἐκεῖ δήσει αὐτοὺς μέχρις αἰῶνος."
										},
										"_id": "2064",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "11"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὕτως ἐχωρίσθη τοῖς πνεύμασιν τῶν ἐντυγχανόντων, οἵτινες ἐνφανίζουσιν περὶ τῆς ἀπωλείας, ὅταν φονευθῶσιν ἐν ταῖς ἡμέραις τῶν ἁμαρτωλῶν."
										},
										"_id": "2065",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "12"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ οὕτως ἐκτίσθη τοῖς πνεύμασιν τῶν ἀνθρώπων, ὅσοι οὐκ ἔσονται ὅσιοι ἀλλὰ ἁμαρτωλοί, καὶ μετὰ τῶν ἀνόμων ἔσονται μέτοχοι. τὰ δὲ πνεύματι, ὅτι οἱ ἐνθάδε θλιβέντες ἔλαττον κολάζονται αὐτῶν, οὐ τιμωρηθήσονται ἐν ἡμέρᾳ τῆς κρίσεως, οὐδὲ μὴ μετεγερθῶσιν ἐντεῦθεν."
										},
										"_id": "2066",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "13"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ηὐλόγησα τὸν κύριον τῆς δόξης, καὶ εἶπα Εὐλογητὸς εἶ, Κύριε ὁ τῆς δικαιοσύνης, κυριεύων τοῦ αἰῶνος."
										},
										"_id": "2067",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "14"
								}
							],
							"_number": "22"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Κἀκεῖθεν ἐφώδευσα εἰς ἄλλον τόπον πρὸς δυσμὰς τῶν περάτων τῆς γῆς."
										},
										"_id": "2068",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐθεασάμην πῦρ διατρέχον καὶ οὐκ ἀναπαυόμενον οὐδὲ ἐλλεῖπον τοῦ δρόμου, ἡμέρας καὶ νυκτὸς ἅμα διαμένον."
										},
										"_id": "2069",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἠρώτησα λέγων Τί ἐστιν τὸ μὴ ἔχον ἀνάπαυσιν;"
										},
										"_id": "2070",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπεκρίθη μοι Ῥαγουήλ, ὁ εἷς τῶν ἁγίων ἀγγέλων ὃς μετ᾽ ἐμοῦ ἦν Οὗτος ὁ δρόμος τοῦ πυρὸς τὸ πρὸς δυσμὰς πῦρ τὸ ἐκδιῶκόν ἐστιν πάντας τοὺς φωστῆρας τοῦ οὐρανοῦ."
										},
										"_id": "2071",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								}
							],
							"_number": "23"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἔδειξέν μοι ὄρη πυρὸς καιόμενα νυκτός."
										},
										"_id": "2072",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐπέκεινα αὐτῶν ἐπορεύθην καὶ ἐθεασάμην ἑπτὰ ὄρη, ἔνδοξα πάντα, ἑκατέρου διαλλάσσοντα, ὦν οἱ λίθοι ἔντιμοι τῇ καλλονῇ, καὶ πάντα ἔντιμα καὶ ἔνδοξα καὶ εὐειδῆ, τρία ἐπ᾽ ἀνατολὰς ἐστηριγμένα ἐν τῷ ἑνί, καὶ τρία ἐπὶ νότον ἐν τῷ ἑνὶ καὶ φάραγγες βαθεῖαι καὶ τραχεῖαι, μία τῇ μιᾷ οὐκ ἐγγίζουσαι,"
										},
										"_id": "2073",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τῷ ὄρει ἕβδομον ὄρος ἀνὰ μέσον τούτων, καὶ ὑπερεῖχεν τῷ ὕψει, ὅμοιον καθέδρᾳ θρόνου, καὶ περιεκύκλου δένδρα αὐτῷ εὐειδῆ."
										},
										"_id": "2074",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἦν ἐν αὐτοῖς δένδρον ὃ οὐδέποτε ὤσφρανμαι καὶ οὐδεὶς ἕτερος αὐτῷ ηὐφράνθη, καὶ οὐδὲν ἕτερον ὅμοιον αὐτῷ· ὀσμὴν εἶχεν εὐωδεστέραν πάντων ἀρωμάτων, καὶ τὰ φύλλα αὐτοῦ καὶ τὸ ἄνθος καὶ τὸ δένδρον οὐ φθίνει εἰς τὸν αἰῶνα. οἱ δὲ περὶ τὸν καρπὸν ὡσεὶ βότρυες φοινίκων."
										},
										"_id": "2075",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε εἲπον ὡς καλὸν τὸ δένδρον τοῦτό ἐστιν καὶ εὐῶδες, καὶ ὡραῖα τὰ φύλλα, καὶ τὰ ἄνθη αὐτοῦ ὡραῖα τῇ ὁράσει."
										},
										"_id": "2076",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπεκρίθη μοι Μιχαήλ, εἷς τῶν ἁγίων ἀγγέλων ὃς μετ᾽ ἐμοῦ ἦν—καὶ αὐτὸς αὐτῶν ἡγεῖτο—"
										},
										"_id": "2077",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								}
							],
							"_number": "24"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ εἶπέν μοι Ἑνὼχ, τί ἐρωτᾷς καὶ τί ἐθαύμασας ἐν τῇ ὀσμῇ τοῦ δένδρου, καὶ διὰ τί θέλεις τὴν ἀλήθειαν μαθεῖν;"
										},
										"_id": "2078",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπεκρίθην αὐτῷ Περὶ πάντων εἰδέναι θέλω, μάλιστα δὲ περὶ τοῦ δένδρου τούτου σφόδρα."
										},
										"_id": "2079",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἀπεκρίθη λέγων Τοῦτο τὸ ὄρος τὸ ὑψηλόν, οὗ ἡ κορυφὴ ὁμοία θρόνου θεοῦ, καθέδρα ἐστιν οὗ καθίζει ὁ μέγας κύριος, ὁ ἅγιος τῆς δόξης ὁ βασιλεὺς τοῦ αἰῶνος, ὅταν καταβῇ ἐπισκέψασθαι τὴν γῆν ἐπ᾽ ἀγαθῷ."
										},
										"_id": "2080",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τοῦτο τὸ δένδρον εὐωδίας, καὶ οὐδεμία σὰρξ ἐξουσίαν ἔχει ἅψασθαι αὐτοῦ μέχρι τῆς μεγάλης κρίσεως, ἐν ᾗ ἐκδίκησις πάντων καὶ τελείωσις μέχρις αἰῶνος· τότε δικαίοις καὶ ὁσίοις δοθήσεται"
										},
										"_id": "2081",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὁ καρπὸς αὐτοῦ τοῖς ἐκλεκτοῖς εἰς ζωὴν εἰς βορρᾶν, καὶ μεταφυτευθήσεται ἐν τόπῳ ἁγίῳ παρὰ τὸν οἶκον τοῦ θεοῦ βασιλέως τοῦ αἰῶνος."
										},
										"_id": "2082",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε εὐφρανθήσονται εὐφραινόμενοι καὶ χαρήσονται καὶ εἰς τὸ ἅγιον εἰσελεύσονται· αἱ ὀσμαὶ αὐτοῦ ἐν τοῖς ὀστέοις αὐτῶν, καὶ ζωὴν πλείονα ζήσονται ἐπὶ γῆς ἣν ἔζησαν οἱ πατέρες σου, καὶ ἐν ταῖς ἡμέραις αὐτῶν καὶ βάσανοι καὶ πληγαὶ καὶ μάστιγες οὐχ ἅψονται αὐτῶν."
										},
										"_id": "2083",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ηὐλόγησα τὸν θεὸν τῆς δόξης, τὸν βασιλέα τοῦ αἰῶνος, ὃς ἡτοίμασεν ἀνθρώποις τὰ τοιαῦτα δικαίοις, καὶ αὐτὰ ἔκτισεν καὶ εἶπεν δοῦναι αὐτοῖς."
										},
										"_id": "2084",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "7"
								}
							],
							"_number": "25"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἐκεῖθεν ἐφώδευσα εἰς τὸ μέσον τῆς γῆς, καὶ ἴδον τόπον ηὐλογημένον, ἐκκοπέντος."
										},
										"_id": "2085",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "κἀκεῖ τεθέαμαι ὄρος ἅγιον· ὑποκάτω τοῦ ὄρους ὕδωρ ἐξ ἀνατολῶν, καὶ τὴν δύσιν εἶχεν πρὸς νότον."
										},
										"_id": "2086",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἴδον πρὸς ἀνατολὰς ἄλλο ὄρος ὑψηλότερον τούτου, καὶ ἀνὰ μέσον αὐτοῦ φάραγγα βαθεῖαν, οὐκ ἔχουσαν πλάτος, καὶ δι᾽ αὐτῆς ὕδωρ πορεύεται ὑποκάτω ὑπὸ τὸ ὄρος."
										},
										"_id": "2087",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πρὸς δυσμὰς τούτου ἄλλο ὄρος ταπεινότερον αὐτοῦ καὶ οὐκ ἔχον ὕψος, καὶ φάραγγα βαθεῖαν καὶ ξηρὰν ἀνὰ μέσον αὐτῶν, καὶ ἄλλην φάραγγα βαθεῖαν καὶ ξηρὰν ἐπ᾽ ἄκρων τῶν τριῶν ὀρέων."
										},
										"_id": "2088",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ πᾶσαι φάραγγα βαθεῖαν ἐκ πέτρας στερεᾶς, καὶ δένδρον οὐκ ἐφυτεύετο ἐπ᾽ αὐτάς."
										},
										"_id": "2089",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐθαύμασα περὶ τῆς φάραγγος, καὶ λίαν ἐθαύμασα."
										},
										"_id": "2090",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								}
							],
							"_number": "26"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ εἶπον Διὰ τί ἡ γῆ αὕτη ἡ εὐλογημένη καὶ πᾶσα πλήρης δένδρων, αὐτὴ δὲ ἡ φάραγξ κεκατηραμένη ἐστίν;"
										},
										"_id": "2091",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "γῆ κατάρατος τοῖς κεκατηραμένοις ἐστὶν μέχρι αἰῶνος. ὧδε ἐπισυναχθήσονται πάντες οἱ κεκατηραμένοι οἵτινες ἐροῦσιν τῷ στόματι αὐτῶν κατὰ Κυρίου φωνὴν ἀπρεπῆ, καὶ περὶ τῆς δόξης αὐτοῦ σκληρὰ λαλήσουσιν. ὧδε ἐπισυναχθήσονται, καὶ ὧδε ἔσται τὸ οἰκητήριον."
										},
										"_id": "2092",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐπ᾽ ἐσχάτοις αἰῶσι, ἐν ταῖς ἡμέραις τῆς κρίσεως τῆς ἀληθινῆς ἐναντίον τῶν δικαίων εἰς τὸν ἅπαντα χρόνον ὧδε εὐλογήσουσιν οἱ ἀσεβεῖς τὸν κύριον τῆς δόξης, τὸν βασιλέα τοῦ αἰῶνος·"
										},
										"_id": "2093",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐν ταῖς ἡμέραις τῆς κρίσεως αὐτῶν εὐλογήσουσιν ἐν ἐλέει, ὡς ἐμέρισεν αὐτοῖς."
										},
										"_id": "2094",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ηὐλόγησα τὸν κύριον τῆς δόξης, καὶ τὴν δόξαν αὐτοῦ ἐδήλωσα καὶ ὕμνησα μεγαλοπρεπῶς."
										},
										"_id": "2095",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								}
							],
							"_number": "27"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἐκεῖθεν ἐπορεύθην εἰς τὸ μέσον Μανδοβαρά, καὶ ἴδον αὐτὸ ἔρημον· καὶ αὐτὸ μόνον"
										},
										"_id": "2096",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "πλήρης δένδρων καὶ ἀπὸ τῶν σπερμάτων ὕδωρ ἄνομβρον ἄνωθεν φερόμενον,"
										},
										"_id": "2097",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὡς ὑδραγωγὸς δαψιλὴς ὡς πρὸς βορρᾶν ἐπὶ δυσμῶν πάντοθεν ἀνάγει ὕδωρ καὶ δρόσον."
										},
										"_id": "2098",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								}
							],
							"_number": "28"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Ἔτι ἐκεῖθεν ἐπορεύθην εἰς ἄλλον τόπον ἐν τῷ Βαβδηρά, καὶ πρὸς ἀνατολὰς τοῦ ὄρους τούτου ᾠχόμην,"
										},
										"_id": "2099",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἴδον κρίσεως δένδρα πνέοντα ἀρωμάτων, λιβάνων καὶ ζμύρνας, καὶ τὰ δένδρα αὐτῶν ὅμοια καρύαις."
										},
										"_id": "2100",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								}
							],
							"_number": "29"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἐπέκεινα τούτων ᾠχόμην πρὸς ἀνατολὰς μακράν, καὶ ἴδον τόπον ἄλλον μέγαν, φάραγγα ὕδατος,"
										},
										"_id": "2101",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ἐν ᾧ καὶ δένδρα χρόα ἀρωμάτων ὁμοίων σχίνῳ,"
										},
										"_id": "2102",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ τὰ παρὰ τὰ χείλη τῶν φαράγγων τούτων ἴδον κιννάμωμον ἀρωμάτων· καὶ ἐπέκεινα τούτων ᾠχόμην πρὸς ἀνατολάς."
										},
										"_id": "2103",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								}
							],
							"_number": "30"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "Καὶ ἴδον ἄλλα ὄρη καὶ ἐν αὐτοῖς ἄλση δένδρων, καὶ ἐκπορευόμενον ἐξ αὐτῶν νέκταρ τὸ καλούμενον σαρρὰν καὶ χαλβάνη."
										},
										"_id": "2104",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐπέκεινα τῶν ὀρέων τούτων ἴδον ἄλλο ὄρος πρὸς ἀνατολὰς τῶν περάτων τῆς γῆς, καὶ πάντα τὰ δένδρα πλήρη ἐξαυτῆς ἐν ὁμοιώματι ἀμυγδάλων,"
										},
										"_id": "2105",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὅταν τριβῶσιν· διὸ εὐωδέστερον ὑπὲρ πάντων τῶν ἀρωμάτων."
										},
										"_id": "2106",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								}
							],
							"_number": "31"
						},
						{
							"div": [
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "[Μετὰ τῶν ἀρωμάτων τῶν τούτων,] εἰς βορρᾶν πρὸς ἀνατολὰς τεθέαμαι ἑπτὰ ὄρη πλήρη νάρδου χρηστοῦ καὶ σχίνου καὶ κινναμώμου καὶ πιπέρως."
										},
										"_id": "2107",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "1"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἐκεῖθεν ἐφώδευσα εἰς τὰς ἀρχὰς πάντων τῶν ὀρέων τούτων, μακρὰν ἀπέχων πρὸς ἀνατολὰς τῆς γῆς, καὶ διέβην ἐπάνω τῆς ἐρυθρᾶς θαλάσσης, καὶ ᾠχόμην ἐπ᾽ ἄκρων, καὶ ἀπὸ τούτου διέβην ἐπάνω τοῦ Ζωτιήλ."
										},
										"_id": "2108",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "2"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "καὶ ἦλθον πρὸς τὸν παράδεισον τῆς δικαιοσύνης, καὶ ἴδον μακρόθεν τῶν δένδρων τούτων δένδρα πλείονα καὶ μεγάλα δύο μὲν ἐκεῖ, μεγάλα σφόδρα καλὰ καὶ ἔνδοξα καὶ μεγαλοπρεπῆ, καὶ τὸ δένδρον τῆς φρονήσεως, οὗ ἐσθίουσιν ἅγιοι τοῦ καρποῦ αὐτοῦ καὶ ἐπίστανται φρόνησιν μεγάλην."
										},
										"_id": "2109",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "3"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "ὅμοιον τὸ δένδρον ἐκεῖνο στροβιλέᾳ τὸ ὕψος, τὰ δὲ φύλλα αὐτοῦ κερατίᾳ ὅμοια, ὁ δὲ καρπὸς αὐτοῦ ὡσεὶ βότρυες ἀμπέλου ἱλαροὶ λίαν, ἡ δὲ ὀσμὴ αὐτοῦ διέτρεχεν πόρρω ἀπὸ τοῦ δένδρου."
										},
										"_id": "2110",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "4"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε εἶπον ὡς καλὸν τὸ δένδρον, καὶ ὡς ἐπίχαρι τῇ ὁράσει."
										},
										"_id": "2111",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "5"
								},
								{
									"unit": {
										"reading": {
											"_option": "0",
											"_mss": "Gizeh ",
											"__text": "τότε ἀπεκρίθη Ῥαφαήλ, ὁ ἅγιος ἄγγελος ὁ μετ᾽ ἐμοῦ ὤν, Τοῦτο τὸ δένδρον φρονήσεως, ἐξ οὗ ἔφαγεν ὁ πατήρ σου . . ."
										},
										"_id": "2112",
										"_group": "0",
										"_parallel": ""
									},
									"_number": "6"
								}
							],
							"_number": "32"
						},
