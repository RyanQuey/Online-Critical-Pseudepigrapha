												}
											],
											"_id": "2012",
											"_group": "0",
											"_parallel": ""
										},
										{
											"reading": {
												"_option": "0",
												"_mss": "Gizeh Gizeh2 ",
												"__text": "ἐθεασάμην ἔργον φοβερόν· ἑώρακα οὔτε οὐρανὸν ἐπάνω, οὔτε γῆν"
											},
